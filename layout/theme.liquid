<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#2e3a22">

  {%- comment -%} ---------- SEO : titre & description (compléments alimentaires · Aix-en-Provence / Provence) ---------- {%- endcomment -%}
  {%- assign seo_suffix = 'Compléments alimentaires naturels en Provence' -%}
  {%- if template.name == 'index' -%}
    <title>{{ shop.name }} — {{ seo_suffix }} | Aix-en-Provence</title>
  {%- else -%}
    <title>{{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {%- endif -%}

  {%- capture default_desc -%}Natélis, compléments alimentaires d'origine naturelle formulés en Provence, près d'Aix-en-Provence. Immunité, sommeil, stress, beauté, énergie : des cures ciblées, traçables et fabriquées en France.{%- endcapture -%}
  {%- if page_description != blank -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="{{ default_desc | escape }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Open Graph / Twitter {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
  <meta property="og:description" content="{{ page_description | default: default_desc | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:locale" content="fr_FR">
  {%- if template.name == 'product' and product.featured_image -%}
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  {%- elsif page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- assign hfont = settings.heading_font_name | default: 'Cormorant Garamond' -%}
  {%- assign bfont = settings.body_font_name | default: 'Mulish' -%}
  {%- assign hfam = hfont | replace: ' ', '+' -%}
  {%- assign bfam = bfont | replace: ' ', '+' -%}
  {%- if hfont == bfont -%}
    <link href="https://fonts.googleapis.com/css2?family={{ hfam }}:wght@400;500;600;700&display=swap" rel="stylesheet">
  {%- else -%}
    <link href="https://fonts.googleapis.com/css2?family={{ hfam }}:wght@400;500;600;700&family={{ bfam }}:wght@400;500;600;700&display=swap" rel="stylesheet">
  {%- endif -%}

  {{ content_for_header }}
  {{ 'natelis.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Réglages de thème (couleurs & polices) éditables dans Personnaliser → Paramètres {%- endcomment -%}
  <style>
    :root{
      --cream: {{ settings.color_bg | default: '#FFFFFF' }};
      --soft: {{ settings.color_soft | default: '#FAFAF9' }};
      --pale: {{ settings.color_section_bg | default: '#EEF1E7' }};
      --green-deep: {{ settings.color_text | default: '#2e3a22' }};
      --olive: {{ settings.color_accent | default: '#526F12' }};
      --olive-light: {{ settings.color_accent_light | default: '#758C41' }};
      --brown: {{ settings.color_brown | default: '#7B6C50' }};
      --autumn: {{ settings.color_autumn | default: '#B5651D' }};
      --terra: {{ settings.color_terra | default: '#9a3b2e' }};
      --border: {{ settings.color_border | default: '#ECE4D6' }};
      --serif: "{{ hfont }}", Georgia, serif;
      --sans: "{{ bfont }}", -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .nat-logo-text{ color: {{ settings.color_logo | default: '#4F7A1F' }}; }
  </style>
  {% render 'seo-schema' %}
</head>
<body>
  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'newsletter' %}
  {% section 'footer' %}
  {% section 'popup-welcome' %}
  {% render 'cart-toast' %}
</body>
</html>
