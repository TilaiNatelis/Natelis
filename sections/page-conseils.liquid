        { "type": "text", "id": "tag", "label": "Thématique (tag d'article)", "info": "Laisser vide pour afficher tous les articles du blog." },
        { "type": "range", "id": "limit", "label": "Articles affichés", "min": 3, "max": 20, "step": 1, "default": 12 },
        { "type": "select", "id": "show_chips", "label": "Afficher les filtres par thématique", "default": "false", "options": [ {"value":"true","label":"Oui"}, {"value":"false","label":"Non"} ] }
      ]
    },
    {
      "type": "faq", "name": "Question FAQ",
      "settings": [
        { "type": "text", "id": "q", "label": "Question" },
        { "type": "textarea", "id": "a", "label": "Réponse" }
      ]
    }
  ],
  "presets": [
    { "name": "Page Conseils", "blocks": [
      { "type": "rail", "settings": { "title": "Le guide des actifs", "subtitle": "Tout comprendre pour mieux choisir.", "tag": "", "show_chips": "true" } },
      { "type": "rail", "settings": { "title": "Bien-être au quotidien", "subtitle": "Sommeil, digestion, équilibre.", "tag": "Bien-être" } },
      { "type": "rail", "settings": { "title": "Beauté", "subtitle": "Peau, cheveux et ongles.", "tag": "Beauté" } },
      { "type": "rail", "settings": { "title": "Énergie", "subtitle": "Retrouver du tonus, durablement.", "tag": "Énergie" } },
      { "type": "rail", "settings": { "title": "Au fil des saisons", "subtitle": "Adapter sa cure au moment de l'année.", "tag": "Saison" } },
      { "type": "rail", "settings": { "title": "Nos conseils d'experts", "subtitle": "Posologie, associations, bonnes pratiques.", "tag": "Conseils" } },
      { "type": "rail", "settings": { "title": "Terroir & savoir-faire", "subtitle": "D'où viennent nos actifs.", "tag": "Terroir" } },
      { "type": "faq", "settings": { "q": "Combien de temps dure une cure ?", "a": "La plupart de nos cures se prennent sur 1 à 3 mois. Les effets s'installent progressivement : comptez 2 à 4 semaines pour les premiers ressentis." } },
      { "type": "faq", "settings": { "q": "Peut-on associer plusieurs compléments ?", "a": "Oui, à condition de rester cohérent. Un actif principal et un ou deux compléments de soutien suffisent. Notre diagnostic compose pour vous une routine équilibrée." } },
