{% render 'section-fonts', section: section %}
{%- assign cblog = blogs[section.settings.blog] -%}
{%- if cblog == blank or cblog.articles_count == 0 -%}{%- assign cblog = blogs['carnet-de-la-vigne'] -%}{%- endif -%}

<!-- en-tête -->
<div style="background:var(--pale);">
  <div style="max-width:920px;margin:0 auto;padding:64px 48px 56px;text-align:center;">
    <div class="nat-eyebrow" style="letter-spacing:.28em;">{{ section.settings.hero_eyebrow }}</div>
    <h1 class="nat-serif" style="font-size:54px;line-height:1.05;margin:16px 0 0;">{{ section.settings.hero_title }}</h1>
    <p style="font-size:16.5px;line-height:1.7;color:var(--green-text);margin:16px auto 0;max-width:620px;">{{ section.settings.hero_text }}</p>
  </div>
</div>

<!-- texte libre éventuel (Admin > Pages > contenu) -->
{%- if page.content != blank -%}
  <div class="nat-wrap nat-rte" style="max-width:760px;padding-top:46px;padding-bottom:0;font-size:17px;line-height:1.85;color:var(--brown-dark);">
    {{ page.content }}
  </div>
{%- endif -%}

<!-- rayons de conseils, un par thématique -->
<div class="nat-wrap" style="padding-bottom:16px;">
  {%- for block in section.blocks -%}
    {%- if block.type == 'rail' -%}
      {%- render 'conseil-rail',
            rail_blog: cblog,
            rail_tag: block.settings.tag,
            rail_title: block.settings.title,
            rail_sub: block.settings.subtitle,
            rail_limit: block.settings.limit,
            rail_chips: block.settings.show_chips,
            rail_id: block.id,
            rail_attrs: block.shopify_attributes -%}
    {%- endif -%}
  {%- endfor -%}
</div>

<!-- la méthode en 3 étapes -->
<div class="nat-wrap" style="padding-top:70px;padding-bottom:8px;">
  <h2 class="nat-h2" style="font-size:32px;margin:0 0 26px;">{{ section.settings.method_title }}</h2>
  <div class="nat-grid-3" style="gap:36px;">
    {%- assign steps_n = '01,02,03' | split: ',' -%}
    {%- assign steps_t = 'Cibler votre besoin,Choisir les bons actifs,Installer le rituel' | split: ',' -%}
    {%- assign steps_d = "Immunité, sommeil, stress, beauté… Partez d'un objectif clair plutôt que d'accumuler les compléments.|Privilégiez des formes assimilables et bien dosées. Un actif principal, un ou deux en soutien suffisent.|Une cure se vit sur 1 à 3 mois. Associez la prise à un moment fixe de la journée pour ne rien oublier." | split: '|' -%}
    {%- for n in steps_n -%}
      <div style="border-top:2px solid var(--green-deep);padding-top:22px;">
        <div class="nat-serif" style="font-size:42px;color:var(--sage);line-height:1;">{{ n }}</div>
        <div style="font-size:20px;font-weight:700;color:var(--green-deep);margin-top:14px;">{{ steps_t[forloop.index0] }}</div>
        <p style="font-size:14px;line-height:1.65;color:var(--brown);margin:10px 0 0;">{{ steps_d[forloop.index0] }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

<!-- composer sa routine + diagnostic -->
<div class="nat-wrap" style="padding-top:56px;padding-bottom:56px;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;overflow:hidden;box-shadow:0 1px 16px rgba(12,17,14,.07);">
    {%- if section.settings.image != blank -%}{%- assign cons_img = section.settings.image | image_url: width: 1000 -%}{%- else -%}{%- assign cons_img = 'prov-lavande.jpg' | asset_url -%}{%- endif -%}
    <div style="background-image:url('{{ cons_img }}');background-size:cover;background-position:center;min-height:440px;"></div>
    <div style="background:#fff;padding:54px 52px;display:flex;flex-direction:column;justify-content:center;">
      <div class="nat-eyebrow" style="letter-spacing:.22em;">La routine idéale</div>
      <h2 class="nat-serif" style="font-size:36px;line-height:1.08;margin:14px 0 22px;">Composer une cure qui vous ressemble</h2>
      <div style="display:flex;flex-direction:column;gap:15px;">
        {%- assign checks = "Une cure ciblée sur 1 à 3 mois, plutôt qu'une prise ponctuelle|Le matin pour l'énergie, le soir pour la détente et le sommeil|Trois à quatre compléments complémentaires au maximum|Une pause d'une à deux semaines entre deux cures intensives" | split: '|' -%}
        {%- for c in checks -%}
          <div style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--olive);">✦</span><span style="font-size:14.5px;color:var(--green-text);line-height:1.5;">{{ c }}</span></div>
        {%- endfor -%}
      </div>
      <a class="nat-btn" style="align-self:flex-start;margin-top:30px;" href="{{ section.settings.diag_url | default: '/pages/diagnostic' }}">Faire mon diagnostic →</a>
    </div>
  </div>
</div>

<!-- FAQ -->
<div style="max-width:900px;margin:0 auto;padding:10px 48px 80px;">
  <h2 class="nat-h2" style="font-size:32px;margin:0 0 24px;text-align:center;">Questions fréquentes</h2>
  {%- for block in section.blocks -%}
    {%- if block.type == 'faq' -%}
      <details style="border-top:1px solid var(--border);" {{ block.shopify_attributes }}>
        <summary style="display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 4px;cursor:pointer;list-style:none;font-size:17px;font-weight:700;color:var(--green-deep);">{{ block.settings.q }}<span style="font-size:24px;color:var(--olive-light);">+</span></summary>
        <p style="font-size:14.5px;line-height:1.7;color:var(--brown);margin:0;padding:0 4px 24px;max-width:700px;">{{ block.settings.a }}</p>
      </details>
    {%- endif -%}
  {%- endfor -%}
  <div style="border-top:1px solid var(--border);"></div>
</div>

<script>
  (function(){
    // flèches de défilement : une paire par rayon, désactivées en bout de piste
    document.querySelectorAll('.nat-rail__viewport').forEach(function(vp){
      var track = vp.querySelector('.nat-rail__track');
      var prev  = vp.querySelector('.nat-rail__arrow--prev');
      var next  = vp.querySelector('.nat-rail__arrow--next');
      if(!track || !prev || !next) return;

      function step(){
        var card = track.querySelector('.nat-pcard');
        var gap  = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 18;
        return card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
      }
      function refresh(){
        var max = track.scrollWidth - track.clientWidth - 2;
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = max <= 0 || track.scrollLeft >= max;
      }
      [prev, next].forEach(function(btn){
        btn.addEventListener('click', function(){
          track.scrollBy({ left: step() * parseInt(btn.dataset.dir, 10), behavior: 'smooth' });
        });
      });
      track.addEventListener('scroll', refresh, { passive: true });
      window.addEventListener('resize', refresh);
      refresh();
    });
  })();
</script>

{% schema %}
{
  "name": "Page Conseils",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "hero_eyebrow", "label": "Sur-titre", "default": "Le guide Natélis" },
    { "type": "text", "id": "hero_title", "label": "Titre", "default": "Bien choisir ses compléments alimentaires" },
    { "type": "textarea", "id": "hero_text", "label": "Texte", "default": "Pas besoin d'accumuler les compléments. Partez d'un objectif, choisissez les bons actifs, installez un rituel — on vous explique tout, depuis la Provence." },
    { "type": "header", "content": "Source des articles" },
    { "type": "blog", "id": "blog", "label": "Blog des conseils", "info": "Chaque rayon puise ses articles dans ce blog, filtré par thématique." },
    { "type": "header", "content": "La méthode" },
    { "type": "text", "id": "method_title", "label": "Titre", "default": "La méthode Natélis en 3 étapes" },
    { "type": "header", "content": "Bloc routine" },
    { "type": "image_picker", "id": "image", "label": "Image routine" },
    { "type": "url", "id": "diag_url", "label": "Lien diagnostic" }
  ],
  "blocks": [
    {
      "type": "rail", "name": "Rayon de conseils",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre du rayon", "default": "Nos conseils" },
