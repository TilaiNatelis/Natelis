{% render 'section-fonts', section: section %}
{%- comment -%}
  Suivez-nous : grille de visuels renvoyant vers le compte social.
  À défaut d'images choisies, on reprend les visuels d'ambiance du thème.
{%- endcomment -%}
<div class="nat-wrap" style="padding-top:52px;padding-bottom:56px;">
  <div class="nat-section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="nat-section-head__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nat-h2">{{ section.settings.title }}</h2>
    </div>
    {%- if section.settings.handle != blank -%}
      <a class="nat-link" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.handle }} →</a>
    {%- endif -%}
  </div>

  <div class="nat-social">
    {%- assign soc_defaults = 'prov-vignes.jpg,prov-lavande.jpg,prov-calanque.jpg,prov-calanque2.jpg,automne.webp,hero-1.png' | split: ',' -%}
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          {%- assign soc_img = block.settings.image | image_url: width: 600 -%}
        {%- else -%}
          {%- assign def = soc_defaults[forloop.index0] | default: soc_defaults.first -%}
          {%- assign soc_img = def | asset_url -%}
        {%- endif -%}
        <a class="nat-social__item" href="{{ block.settings.link | default: section.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <img src="{{ soc_img }}" alt="{{ block.settings.alt | default: shop.name | escape }}" loading="lazy">
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for def in soc_defaults -%}
        <a class="nat-social__item" href="{{ section.settings.link }}" target="_blank" rel="noopener">
          <img src="{{ def | asset_url }}" alt="{{ shop.name | escape }}" loading="lazy">
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Suivez-nous",
  "max_blocks": 12,
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La vie Natélis" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Suivez-nous" },
    { "type": "text", "id": "handle", "label": "Libellé du lien", "default": "Voir sur Instagram" },
    { "type": "url", "id": "link", "label": "Lien du compte" }
  ],
  "blocks": [
    {
      "type": "post", "name": "Publication",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Visuel" },
        { "type": "text", "id": "alt", "label": "Description de l'image" },
        { "type": "url", "id": "link", "label": "Lien de la publication" }
      ]
    }
  ],
  "presets": [ { "name": "Suivez-nous" } ]
}
{% endschema %}
