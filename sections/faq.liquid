{% render 'section-fonts', section: section %}
<div style="background:var(--pale);">
  <div style="max-width:820px;margin:0 auto;padding:64px 32px 50px;text-align:center;">
    <div class="nat-eyebrow">{{ section.settings.eyebrow | default: 'Aide & FAQ' }}</div>
    <h1 class="nat-serif" style="font-size:52px;line-height:1.05;margin:14px 0 0;">{{ section.settings.title | default: 'Questions fréquentes' }}</h1>
    {%- if section.settings.intro != blank -%}<p style="font-size:16px;color:var(--green-text);margin:14px auto 0;max-width:560px;">{{ section.settings.intro }}</p>{%- endif -%}
  </div>
</div>

<div class="nat-wrap" style="max-width:820px;padding-top:40px;padding-bottom:30px;">
  <div class="nat-acc">
    {%- for block in section.blocks -%}
      <details class="nat-acc__item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.q }}</summary>
        <div class="nat-acc__body">{{ block.settings.a }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{%- if page.content != blank -%}
  <div class="nat-wrap nat-rte" style="max-width:820px;padding-bottom:40px;font-size:15.5px;line-height:1.8;color:var(--brown-dark);">{{ page.content }}</div>
{%- endif -%}

<div style="text-align:center;padding-bottom:74px;">
  <a class="nat-btn nat-btn--outline" href="{{ routes.root_url }}pages/contact">Une autre question ? Contactez-nous</a>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Aide & FAQ" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Questions fréquentes" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Livraison, paiement, cures : toutes les réponses au même endroit." },
    { "type": "header", "content": "Polices (cette section)" },
    { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
    { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "textarea", "id": "a", "label": "Réponse" }
    ] }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [
      { "type": "qa", "settings": { "q": "Quels sont les délais et frais de livraison ?", "a": "La livraison est offerte dès 49€ d'achat. En dessous, des frais réduits s'appliquent. Les commandes sont expédiées sous 24–48 h ouvrées." } },
      { "type": "qa", "settings": { "q": "Quels moyens de paiement acceptez-vous ?", "a": "Carte bancaire, Apple Pay, Google Pay et PayPal, via un paiement 100% sécurisé." } },
      { "type": "qa", "settings": { "q": "Puis-je retourner un produit ?", "a": "Vous disposez de 30 jours (satisfait ou remboursé). Pour des raisons d'hygiène, les produits ouverts ne peuvent être repris." } },
      { "type": "qa", "settings": { "q": "Combien de temps dure une cure ?", "a": "La plupart de nos cures se prennent sur 1 à 3 mois. Comptez 2 à 4 semaines pour les premiers ressentis." } },
      { "type": "qa", "settings": { "q": "Peut-on associer plusieurs compléments ?", "a": "Oui : un actif principal et un ou deux compléments de soutien suffisent. Notre diagnostic compose une routine équilibrée pour vous." } },
      { "type": "qa", "settings": { "q": "Vos compléments conviennent-ils à tout le monde ?", "a": "Nos formules sont d'origine naturelle, sans additifs controversés. En cas de grossesse, d'allaitement, de traitement ou de doute, demandez conseil à un professionnel de santé." } },
      { "type": "qa", "settings": { "q": "Où sont fabriqués vos produits ?", "a": "Nos compléments alimentaires sont formulés en Provence (près d'Aix-en-Provence) et fabriqués en France." } }
    ] }
  ]
}
{% endschema %}
