{% render 'section-fonts', section: section %}
{%- comment -%}
  L'expérience Natélis — rail navigable : autant de rubriques que souhaité,
  quatre visibles à la fois, les suivantes atteignables aux flèches.
{%- endcomment -%}
<div class="nat-wrap" style="padding-top:52px;padding-bottom:46px;">
  <div class="nat-section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="nat-section-head__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nat-h2">{{ section.settings.title }}</h2>
    </div>
    {%- if section.settings.cta != blank -%}
      <a class="nat-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.cta }} →</a>
    {%- endif -%}
  </div>

  <div class="nat-crail" id="NatExp-{{ section.id }}">
    <button type="button" class="nat-crail__arrow nat-crail__arrow--prev" data-dir="-1" aria-label="Précédent" disabled>‹</button>
    <div class="nat-crail__track">
      {%- assign exp_defaults = 'prov-lavande.jpg,prov-calanque.jpg,prov-vignes.jpg,prov-calanque2.jpg,automne.webp,hero-1.png' | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          {%- assign exp_img = block.settings.image | image_url: width: 700 -%}
        {%- else -%}
          {%- assign def = exp_defaults[forloop.index0] | default: exp_defaults.first -%}
          {%- assign exp_img = def | asset_url -%}
        {%- endif -%}
        {%- render 'card-rail',
              cr_image: exp_img,
              cr_title: block.settings.title,
              cr_text: block.settings.text,
              cr_cta: block.settings.cta,
              cr_link: block.settings.link,
              cr_attrs: block.shopify_attributes -%}
      {%- endfor -%}
    </div>
    <button type="button" class="nat-crail__arrow nat-crail__arrow--next" data-dir="1" aria-label="Suivant">›</button>
  </div>
</div>

<script>
  (function(){
    var root = document.getElementById('NatExp-{{ section.id }}');
    if(!root) return;
    var track = root.querySelector('.nat-crail__track');
    var prev  = root.querySelector('.nat-crail__arrow--prev');
    var next  = root.querySelector('.nat-crail__arrow--next');
    if(!track || !prev || !next) return;

    function step(){
      var c = track.querySelector('.nat-ccard');
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 14;
      return c ? c.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
    }
    function refresh(){
      var max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = max <= 0 || track.scrollLeft >= max;
    }
    [prev, next].forEach(function(btn){
      btn.addEventListener('click', function(){
        track.scrollBy({ left: step() * parseInt(btn.dataset.dir, 10), behavior: 'smooth' });
      });
    });
    track.addEventListener('scroll', refresh, { passive: true });
    window.addEventListener('resize', refresh);
    refresh();
  })();
</script>

{% schema %}
{
  "name": "Expérience",
  "max_blocks": 12,
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "L'expérience Natélis" },
    { "type": "text", "id": "cta", "label": "Lien à droite" },
    { "type": "url", "id": "link", "label": "Cible du lien" }
  ],
  "blocks": [
    {
      "type": "card", "name": "Carte",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Texte" },
        { "type": "text", "id": "cta", "label": "Bouton", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    { "name": "Expérience", "blocks": [
      { "type": "card" }, { "type": "card" }, { "type": "card" },
      { "type": "card" }, { "type": "card" }, { "type": "card" }
    ] }
  ]
}
{% endschema %}
