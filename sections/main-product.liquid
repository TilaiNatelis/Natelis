{% render 'section-fonts', section: section %}
{%- assign p = product -%}
{%- assign sub = p.metafields.custom.subtitle | default: p.type -%}
{%- assign units = p.metafields.custom.units -%}

<div style="max-width:1300px;margin:0 auto;padding:30px 48px 80px;">
  <div style="font-size:12.5px;color:#9a8b6c;margin-bottom:26px;">
    <a href="{{ routes.root_url }}">Accueil</a> ·
    <a href="{{ routes.all_products_collection_url }}">Produits</a> ·
    <span style="color:var(--green-deep);">{{ p.title }}</span>
  </div>

  <div class="nat-pdp">

    {%- comment -%} ---------- galerie : mosaïque, tous les visuels visibles ---------- {%- endcomment -%}
    <div class="nat-gal">
      {%- if p.images.size > 0 -%}
        {%- for image in p.images -%}
          <a class="nat-gal__cell{% if p.images.size == 1 %} nat-gal__cell--wide{% endif %}" href="{{ image | image_url: width: 1600 }}" target="_blank" rel="noopener">
            {%- if forloop.first -%}
              {%- if p.compare_at_price_max > p.price_min -%}
                <span class="nat-gal__badge nat-gal__badge--promo">Offre spéciale</span>
              {%- elsif p.tags contains 'Nouveau' -%}
                <span class="nat-gal__badge nat-gal__badge--new">Nouveau</span>
              {%- elsif p.tags contains 'Best-seller' -%}
                <span class="nat-gal__badge">Best-seller</span>
              {%- endif -%}
            {%- endif -%}
            <img src="{{ image | image_url: width: 1000 }}" alt="{{ image.alt | default: p.title | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %}>
          </a>
        {%- endfor -%}
      {%- else -%}
        <div class="nat-gal__cell nat-gal__cell--wide"><span class="nat-card__ph" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">{{ p.title }}</span></div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- panneau d'achat (suit le défilement) ---------- {%- endcomment -%}
    <div class="nat-pdp__buy">
      {%- comment -%} note Judge.me (se remplit dès les premiers avis) {%- endcomment -%}
      <div style="clear:both"></div>
      <div class="jdgm-widget jdgm-preview-badge" data-id="{{ p.id }}" data-template="product"></div>

      {%- if p.tags.size > 0 -%}<div class="nat-eyebrow" style="margin-top:10px;">{{ p.tags | join: ' · ' }}</div>{%- endif -%}
      <h1 class="nat-pdp__title">{{ p.title }}</h1>

      <div class="nat-pdp__meta">
        <span>{%- if p.selected_or_first_available_variant.sku != blank -%}Réf. {{ p.selected_or_first_available_variant.sku }}{%- elsif sub != blank -%}{{ sub }}{%- endif -%}</span>
        <span>{%- if units != blank -%}{{ units }} unités{%- elsif p.selected_or_first_available_variant.title != 'Default Title' -%}{{ p.selected_or_first_available_variant.title }}{%- endif -%}</span>
      </div>

      <p class="nat-pdp__desc">{{ p.description | strip_html | default: 'Une formule pure et concentrée, pensée pour s’intégrer simplement à votre rituel quotidien. Actifs d’origine naturelle, dosés avec exigence et sans additifs controversés.' }}</p>

      {%- form 'product', p -%}
        <span id="NatBuy-{{ section.id }}"></span>
        {%- unless p.has_only_default_variant -%}
          {%- comment -%}
            Choisir un format sélectionne la variante (rechargement sur son URL)
            et ne déclenche surtout pas l'ajout au panier.
          {%- endcomment -%}
          <div class="nat-vars">
            {%- for variant in p.variants -%}
              <label class="nat-var{% if variant == p.selected_or_first_available_variant %} is-selected{% endif %}{% unless variant.available %} nat-var--soldout{% endunless %}">
                <input type="radio" name="id" value="{{ variant.id }}"
                       {% if variant == p.selected_or_first_available_variant %}checked{% endif %}
                       data-variant-url="{{ p.url }}?variant={{ variant.id }}">
                <span class="nat-var__title">{{ variant.title }}</span>
                <span class="nat-var__price">{{ variant.price | money }}
                  {%- if variant.compare_at_price > variant.price -%}<s class="nat-var__was">{{ variant.compare_at_price | money }}</s>{%- endif -%}
                </span>
              </label>
            {%- endfor -%}
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <div class="nat-pdp__price">{{ p.price | money }}
            {%- if p.compare_at_price_max > p.price_min -%}<s class="nat-card__compare">{{ p.compare_at_price_max | money }}</s>{%- endif -%}
          </div>
        {%- endunless -%}

        <div style="display:flex;align-items:center;gap:14px;margin-top:24px;">
          <div class="nat-qty">
            <span onclick="var q=this.parentNode.querySelector('input');q.value=Math.max(1,(+q.value||1)-1);">−</span>
            <input type="number" name="quantity" value="1" min="1" style="width:46px;text-align:center;border:none;font-size:15px;font-weight:700;font-family:var(--sans);">
            <span onclick="var q=this.parentNode.querySelector('input');q.value=(+q.value||1)+1;">+</span>
          </div>
          <button type="submit" class="nat-btn" style="flex:1;"{% unless p.available %} disabled{% endunless %}>
            {%- if p.available -%}Ajouter au panier · {{ p.price | money }}{%- else -%}Épuisé{%- endif -%}
          </button>
        </div>
      {%- endform -%}

      {%- comment -%} engagements : logos sous la description {%- endcomment -%}
      {%- render 'engagements', eng_product: p, eng_fallback: section.settings.engagements -%}

      {%- assign benefits = p.metafields.custom.benefits.value -%}
      {%- if benefits -%}
        <div class="nat-benefits">
          {%- for b in benefits -%}<div class="nat-benefit"><span>{{ b }}</span></div>{%- endfor -%}
        </div>
      {%- endif -%}
      <div style="font-size:12.5px;color:#9a8b6c;margin-top:22px;line-height:1.6;">Livraison offerte dès 49€ · Fabriqué en France · Sans additifs controversés</div>

      {%- comment -%} Accordéon : composition, provenance, conseils, allergènes, FAQ (métachamps) {%- endcomment -%}
      <div class="nat-acc" style="margin-top:28px;">
        {%- assign composition = p.metafields.custom.composition -%}
        {%- assign usage = p.metafields.custom.usage -%}
        {%- assign allergens = p.metafields.custom.allergens -%}
        {%- assign faq = p.metafields.custom.faq -%}
        {%- if composition != blank -%}<details class="nat-acc__item"><summary>Composition</summary><div class="nat-acc__body">{{ composition }}</div></details>{%- endif -%}
        {%- if usage != blank -%}<details class="nat-acc__item"><summary>Conseils d'utilisation</summary><div class="nat-acc__body">{{ usage }}</div></details>{%- endif -%}

        {%- comment -%}
          Provenance : circuit d'approvisionnement, origine des matières premières,
          lieu de fabrication et certifications. Tout est piloté par métachamps
          (Admin > Produits > Métachamps) ; la rubrique n'apparaît que si au moins
          un champ est renseigné — on n'affiche jamais d'allégation par défaut.
        {%- endcomment -%}
        {%- assign pv_circuit = p.metafields.custom.provenance_circuit -%}
        {%- assign pv_origin = p.metafields.custom.provenance_origine -%}
        {%- assign pv_made = p.metafields.custom.provenance_fabrication -%}
        {%- assign pv_certif = p.metafields.custom.provenance_certifications -%}
        {%- assign pv_text = p.metafields.custom.provenance_texte -%}
        {%- if pv_circuit != blank or pv_origin != blank or pv_made != blank or pv_certif != blank or pv_text != blank -%}
          <details class="nat-acc__item"><summary>Provenance</summary><div class="nat-acc__body">
            <dl class="nat-prov">
              {%- if pv_circuit != blank -%}<dt>Circuit</dt><dd>{{ pv_circuit }}</dd>{%- endif -%}
              {%- if pv_origin != blank -%}<dt>Matières premières</dt><dd>{{ pv_origin }}</dd>{%- endif -%}
              {%- if pv_made != blank -%}<dt>Fabrication</dt><dd>{{ pv_made }}</dd>{%- endif -%}
              {%- if pv_certif != blank -%}<dt>Certifications</dt><dd>{{ pv_certif }}</dd>{%- endif -%}
            </dl>
            {%- if pv_text != blank -%}<p style="margin-top:12px;">{{ pv_text }}</p>{%- endif -%}
          </div></details>
        {%- endif -%}

        {%- if allergens != blank -%}<details class="nat-acc__item"><summary>Allergènes</summary><div class="nat-acc__body">{{ allergens }}</div></details>{%- endif -%}
        {%- if faq != blank -%}
          <details class="nat-acc__item"><summary>Questions fréquentes</summary><div class="nat-acc__body">{{ faq }}</div></details>
        {%- else -%}
          <details class="nat-acc__item"><summary>Questions fréquentes</summary><div class="nat-acc__body">
            <p><strong>Comment prendre ce complément ?</strong><br>Reportez-vous à l'onglet « Conseils d'utilisation », avec un grand verre d'eau, sur une cure de 1 à 3 mois.</p>
            <p><strong>En combien de temps voit-on les premiers effets ?</strong><br>Les bienfaits s'installent progressivement : comptez en général 2 à 4 semaines de prise régulière.</p>
            <p><strong>Peut-on l'associer à d'autres compléments ?</strong><br>Oui : un actif principal et un ou deux de soutien suffisent. Notre diagnostic compose pour vous une routine équilibrée.</p>
            <p><strong>Où sont fabriqués vos compléments ?</strong><br>Nos formules sont développées et fabriquées en France, à partir d'actifs d'origine naturelle et sans additifs controversés.</p>
            <p><strong>À qui s'adressent-ils ?</strong><br>À toute personne adulte souhaitant soutenir son bien-être. Déconseillé aux femmes enceintes ou allaitantes sans avis médical ; en cas de traitement, demandez conseil à un professionnel de santé.</p>
          </div></details>
        {%- endif -%}
        <details class="nat-acc__item"><summary>Précautions d'emploi</summary><div class="nat-acc__body">
          <p>Complément alimentaire. Ne se substitue pas à une alimentation variée et équilibrée ni à un mode de vie sain. Ne pas dépasser la dose journalière recommandée. Tenir hors de portée des enfants. Déconseillé aux femmes enceintes ou allaitantes sans avis médical. En cas de traitement, demandez conseil à un professionnel de santé.</p>
        </div></details>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- ce que disent les études (piloté par métachamp) ---------- {%- endcomment -%}
  {%- render 'product-science', sci_product: p,
        sci_title: section.settings.sci_title,
        sci_note: section.settings.sci_note -%}

  {%- comment -%} ---------- rythme de la cure ---------- {%- endcomment -%}
  {%- render 'product-steps', steps_product: p,
        steps_title: section.settings.steps_title,
        steps_fallback: section.settings.steps_default,
        steps_note: section.settings.steps_note -%}

  {%- comment -%} ---------- rappel d'achat ---------- {%- endcomment -%}
  {%- if p.available -%}
    <div class="nat-recall">
      <div class="nat-recall__box">
        <a class="nat-btn" href="#NatBuy-{{ section.id }}">Ajouter au panier · {{ p.price | money }}</a>
        <p class="nat-recall__note">Livraison offerte dès 49€ · Cure de 1 à 3 mois</p>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- avis clients (Judge.me) ---------- {%- endcomment -%}
  <div class="nat-reviews">
    <div class="nat-reviews__head">
      <p class="nat-section-head__eyebrow">Ils l'ont adopté</p>
      <h2 class="nat-h2">{{ section.settings.reviews_title | default: 'Les avis de nos clients' }}</h2>
    </div>
    <div style="clear:both"></div>
    <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget"
         data-product-title="{{ p.title | escape }}" data-id="{{ p.id }}"></div>
  </div>

  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div style="margin-top:70px;">
      <h2 class="nat-serif" style="font-size:32px;margin:0 0 26px;">Vous aimerez aussi</h2>
      <div class="nat-grid-4">
        {%- for rec in recommendations.products limit: 4 -%}{%- render 'product-card', product: rec -%}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function(){
    // Choisir un format change de variante (et met à jour le prix) sans rien ajouter au panier.
    document.querySelectorAll('input[name="id"][data-variant-url]').forEach(function(input){
      input.addEventListener('change', function(){
        if(input.checked){ window.location.href = input.dataset.variantUrl; }
      });
    });

  })();
</script>

{% schema %}
{ "name": "Produit", "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] },
      { "type": "header", "content": "Engagements", "info": "Affichés sous le bouton d'achat. Un engagement par ligne. Un produit peut surcharger cette liste via son métachamp « engagements »." },
      { "type": "textarea", "id": "engagements", "label": "Engagements par défaut", "default": "Emballage 100% naturel" },
      { "type": "header", "content": "Ce que disent les études", "info": "Le contenu se saisit produit par produit, dans le métachamp « Études ». Une ligne par donnée : chiffre | libellé | phrase | lien." },
      { "type": "text", "id": "sci_title", "label": "Titre", "default": "Ce que disent les études" },
      { "type": "textarea", "id": "sci_note", "label": "Mention légale", "default": "Données issues d'études publiées portant sur l'actif principal de la formule, présentées à titre documentaire. Elles ne préjugent pas des effets individuels et ne constituent pas une allégation de santé propre au produit." },
      { "type": "header", "content": "Rythme de la cure", "info": "Une étape par ligne : titre | délai | phrase. Un produit peut définir son propre rythme via le métachamp « Rythme »." },
      { "type": "text", "id": "steps_title", "label": "Titre", "default": "Le rythme de votre cure" },
      { "type": "textarea", "id": "steps_default", "label": "Étapes par défaut", "default": "Les premiers jours | Semaine 1 | La cure s'installe. C'est la régularité de la prise, à heure fixe, qui compte le plus à ce stade.\nLes premiers ressentis | Semaines 2 à 4 | C'est en général la période où les premiers effets se font sentir, progressivement et variablement selon les personnes.\nLa cure complète | 1 à 3 mois | La durée que nous recommandons pour l'ensemble de nos cures, avant de faire le point sur vos besoins." },
      { "type": "textarea", "id": "steps_note", "label": "Mention sous les étapes", "default": "Ces repères décrivent le déroulé d'une cure et non un effet garanti : les ressentis varient d'une personne à l'autre." },
      { "type": "header", "content": "Avis clients" },
      { "type": "text", "id": "reviews_title", "label": "Titre du bloc avis", "default": "Les avis de nos clients" }
  ] }
{% endschema %}
