<div class="nat-news">
  <div>
    <h2 class="nat-serif" style="font-size:34px;margin:0;">{{ section.settings.title }}</h2>
    <p style="font-size:14px;opacity:.82;margin:10px 0 0;">{{ section.settings.subtitle }}</p>
  </div>
  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="nat-news__form">
      <input class="nat-news__input" type="email" name="contact[email]" placeholder="Votre adresse e-mail" required>
      <button type="submit" class="nat-news__btn">{{ section.settings.cta }}</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p style="font-size:13px;margin-top:10px;width:100%;">Merci, votre inscription est confirmée ✦</p>
    {%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Recevez nos rituels de saison" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Conseils, nouveautés et —15% sur votre première cure." },
    { "type": "text", "id": "cta", "label": "Bouton", "default": "Je m'inscris" }
  ]
}
{% endschema %}
