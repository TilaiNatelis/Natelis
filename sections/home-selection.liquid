{%- assign col_ventes = section.settings.collection_ventes -%}
{%- if col_ventes == blank or col_ventes.products.size == 0 -%}{%- assign col_ventes = collections['meilleures-ventes'] -%}{%- endif -%}
{%- if col_ventes == blank or col_ventes.products.size == 0 -%}{%- assign col_ventes = collections['tous-nos-complements'] -%}{%- endif -%}
{%- if col_ventes == blank or col_ventes.products.size == 0 -%}{%- assign col_ventes = collections.all -%}{%- endif -%}
{%- assign col_nouv = section.settings.collection_nouveautes -%}
{%- if col_nouv == blank or col_nouv.products.size == 0 -%}{%- assign col_nouv = collections['nouveautes'] -%}{%- endif -%}
{%- if col_nouv == blank or col_nouv.products.size == 0 -%}{%- assign col_nouv = collections['tous-nos-complements'] -%}{%- endif -%}
{%- if col_nouv == blank or col_nouv.products.size == 0 -%}{%- assign col_nouv = collections.all -%}{%- endif -%}

<div class="nat-wrap" style="padding-top:64px;padding-bottom:12px;" id="NatSel-{{ section.id }}">
  <div class="nat-section-head">
    <h2 class="nat-h2">{{ section.settings.title }}</h2>
    <a class="nat-link" href="{{ routes.all_products_collection_url }}">Tout voir →</a>
  </div>

  <div class="nat-tabs">
    <button class="nat-tab is-active" data-tab="ventes">Meilleures ventes</button>
    <button class="nat-tab" data-tab="nouv">Nouveautés</button>
  </div>

  <div class="nat-slider-wrap" data-panel="ventes">
    <button class="nat-slider-arrow nat-slider-arrow--prev" data-dir="-1" aria-label="Précédent">‹</button>
    <div class="nat-slider">
      {%- for product in col_ventes.products limit: 12 -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
    <button class="nat-slider-arrow nat-slider-arrow--next" data-dir="1" aria-label="Suivant">›</button>
  </div>

  <div class="nat-slider-wrap" data-panel="nouv" style="display:none;">
    <button class="nat-slider-arrow nat-slider-arrow--prev" data-dir="-1" aria-label="Précédent">‹</button>
    <div class="nat-slider">
      {%- for product in col_nouv.products limit: 12 -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
    <button class="nat-slider-arrow nat-slider-arrow--next" data-dir="1" aria-label="Suivant">›</button>
  </div>
</div>

<script>
  (function(){
    var root = document.getElementById('NatSel-{{ section.id }}');
    if(!root) return;
    // onglets
    root.querySelectorAll('.nat-tab').forEach(function(tab){
      tab.addEventListener('click', function(){
        root.querySelectorAll('.nat-tab').forEach(function(t){ t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        root.querySelectorAll('[data-panel]').forEach(function(p){
          p.style.display = (p.dataset.panel === tab.dataset.tab) ? '' : 'none';
        });
      });
    });
    // flèches de slider
    root.querySelectorAll('.nat-slider-arrow').forEach(function(btn){
      btn.addEventListener('click', function(){
        var slider = btn.parentNode.querySelector('.nat-slider');
        if(slider) slider.scrollBy({ left: (btn.dataset.dir|0) * Math.round(slider.clientWidth * 0.8), behavior:'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Sélection produits",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Votre sélection" },
    { "type": "collection", "id": "collection_ventes", "label": "Collection « Meilleures ventes »" },
    { "type": "collection", "id": "collection_nouveautes", "label": "Collection « Nouveautés »" }
  ],
  "presets": [ { "name": "Sélection produits" } ]
}
{% endschema %}
