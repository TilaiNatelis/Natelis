{%- assign col_ventes = section.settings.collection_ventes -%}
{%- if col_ventes == blank or col_ventes.products.size == 0 -%}{%- assign col_ventes = collections['meilleures-ventes'] -%}{%- endif -%}
{%- assign col_nouv = section.settings.collection_nouveautes -%}
{%- if col_nouv == blank or col_nouv.products.size == 0 -%}{%- assign col_nouv = collections['nouveautes'] -%}{%- endif -%}

<div class="nat-wrap" style="padding-top:64px;padding-bottom:12px;" id="NatSel-{{ section.id }}">
  <div class="nat-section-head">
    <h2 class="nat-h2">{{ section.settings.title }}</h2>
    <a class="nat-link" href="{{ routes.all_products_collection_url }}">Tout voir →</a>
  </div>

  <div class="nat-tabs">
    <button class="nat-tab is-active" data-tab="ventes">Meilleures ventes</button>
    <button class="nat-tab" data-tab="nouv">Nouveautés</button>
  </div>

  <div class="nat-grid-5" data-panel="ventes">
    {%- for product in col_ventes.products limit: 5 -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
  <div class="nat-grid-5" data-panel="nouv" style="display:none;">
    {%- for product in col_nouv.products limit: 5 -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function(){
    var root = document.getElementById('NatSel-{{ section.id }}');
    if(!root) return;
    root.querySelectorAll('.nat-tab').forEach(function(tab){
      tab.addEventListener('click', function(){
        root.querySelectorAll('.nat-tab').forEach(function(t){ t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        root.querySelectorAll('[data-panel]').forEach(function(p){
          p.style.display = (p.dataset.panel === tab.dataset.tab) ? '' : 'none';
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Sélection produits",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Votre sélection" },
    { "type": "collection", "id": "collection_ventes", "label": "Collection « Meilleures ventes »" },
    { "type": "collection", "id": "collection_nouveautes", "label": "Collection « Nouveautés »" }
  ],
  "presets": [ { "name": "Sélection produits" } ]
}
{% endschema %}
