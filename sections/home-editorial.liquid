{% render 'section-fonts', section: section %}
{%- comment -%}
  Bande editoriale pleine largeur : la photo va d'un bord a l'autre et le texte
  se pose au centre, par-dessus. Le rapport 16/7 est celui releve sur la
  capture de reference (440 x 192), comme pour le duo d'offres.
{%- endcomment -%}
{%- if section.settings.image != blank -%}
  {%- assign ed_img = section.settings.image | image_url: width: 2400 -%}
{%- else -%}
  {%- assign ed_img = 'prov-lavande.jpg' | asset_url -%}
{%- endif -%}
<section class="nat-band">
  <img class="nat-band__img" src="{{ ed_img }}" alt="{{ section.settings.title | escape }}" loading="lazy">
  <div class="nat-band__veil"></div>
  <div class="nat-band__body">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nat-band__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="nat-band__title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="nat-band__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="nat-band__btn" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bande éditoriale",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "image_picker", "id": "image", "label": "Image de fond", "info": "Elle occupe toute la largeur de la bande. Prévoir un visuel large et peu chargé au centre, le texte s'y pose par-dessus." },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre savoir-faire" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une nature à l'état brut, distillée avec soin" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Né au cœur de la Provence, Navélie restaure le lien entre le corps et la terre. Des actifs purs, traçables et dosés avec exigence — rien de superflu." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Notre histoire" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton" }
  ],
  "presets": [ { "name": "Bande éditoriale" } ]
}
{% endschema %}
