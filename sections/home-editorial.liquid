{% render 'section-fonts', section: section %}
<div class="nat-split" style="margin-top:72px;">
  {%- if section.settings.image != blank -%}{%- assign ed_img = section.settings.image | image_url: width: 1200 -%}{%- else -%}{%- assign ed_img = 'prov-lavande.jpg' | asset_url -%}{%- endif -%}
  <div class="nat-split__media" style="background-image:url('{{ ed_img }}');"></div>
  <div class="nat-split__body">
    <div class="nat-eyebrow">{{ section.settings.eyebrow }}</div>
    <h2 class="nat-split__title">{{ section.settings.title }}</h2>
    <p class="nat-split__text">{{ section.settings.text }}</p>
    {%- if section.settings.cta_label != blank -%}
      <a class="nat-btn nat-btn--outline" style="align-self:flex-start;" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Bloc éditorial",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La science de la plante" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une nature à l'état brut, distillée avec soin" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Né au cœur de la Provence, Natélis restaure le lien entre le corps et la terre. Des actifs purs, traçables et dosés avec exigence — rien de superflu." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Notre histoire" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton" }
  ],
  "presets": [ { "name": "Bloc éditorial" } ]
}
{% endschema %}
