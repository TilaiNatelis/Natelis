{% render 'section-fonts', section: section %}
{%- comment -%}
  Page Nouveautés — héros éditable + grille de produits 3 par ligne.
  Repli collection : « nouveautes » puis « tous-nos-complements ».
{%- endcomment -%}
{%- assign col = section.settings.collection -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['nouveautes'] -%}{%- endif -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['tous-nos-complements'] -%}{%- endif -%}

<!-- héros -->
{%- if section.settings.image != blank -%}
  <div class="nat-nouv-hero" style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}');">
    <div class="nat-nouv-hero__veil"></div>
    <div class="nat-wrap nat-nouv-hero__inner nat-nouv-hero__inner--img">
      <div class="nat-eyebrow" style="letter-spacing:.26em;color:#fff;">{{ section.settings.eyebrow | default: 'Les dernières arrivées' }}</div>
      <h1 class="nat-serif" style="font-size:54px;line-height:1.02;margin:10px 0 0;color:#fff;text-shadow:0 1px 18px rgba(12,17,14,.4);">{{ section.settings.title | default: 'Nouveautés' }}</h1>
      <p style="font-size:16px;line-height:1.65;margin:16px auto 0;max-width:560px;color:rgba(255,255,255,.92);">{{ section.settings.intro }}</p>
    </div>
  </div>
{%- else -%}
  <div style="background:var(--pale);">
    <div class="nat-wrap" style="max-width:920px;padding:74px 48px 60px;text-align:center;">
      <div class="nat-eyebrow" style="letter-spacing:.26em;">{{ section.settings.eyebrow | default: 'Les dernières arrivées' }}</div>
      <h1 class="nat-serif" style="font-size:58px;line-height:1.02;margin:16px 0 0;">{{ section.settings.title | default: 'Nouveautés' }}</h1>
      <p style="font-size:16.5px;line-height:1.7;color:var(--green-text);margin:18px auto 0;max-width:600px;">{{ section.settings.intro | default: 'Nos dernières cures et formules, fraîchement arrivées en Provence — à découvrir en avant-première.' }}</p>
    </div>
  </div>
{%- endif -%}

<!-- grille 3 par ligne -->
<div class="nat-wrap" style="padding-top:56px;padding-bottom:80px;">
  <div class="nat-section-head">
    <h2 class="nat-h2">{{ section.settings.grid_title | default: 'Tout juste arrivés' }}</h2>
    <a class="nat-link" href="{{ col.url | default: routes.all_products_collection_url }}">Tout voir →</a>
  </div>
  {%- if col != blank and col.products.size > 0 -%}
    <div class="nat-grid-3" style="gap:34px 28px;margin-top:26px;">
      {%- for product in col.products limit: 12 -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p style="color:var(--brown);margin-top:20px;">Les nouveautés arrivent très bientôt.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Page Nouveautés",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Les dernières arrivées" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nouveautés" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Nos dernières cures et formules, fraîchement arrivées en Provence. Les premières à les découvrir, c'est vous." },
    { "type": "image_picker", "id": "image", "label": "Image de fond (optionnelle)" },
    { "type": "header", "content": "Grille produits" },
    { "type": "text", "id": "grid_title", "label": "Titre de la grille", "default": "Tout juste arrivés" },
    { "type": "collection", "id": "collection", "label": "Collection « Nouveautés »", "info": "Par défaut la collection « nouveautes »." }
  ],
  "presets": [ { "name": "Page Nouveautés" } ]
}
{% endschema %}
