{% render 'section-fonts', section: section %}
{%- comment -%}
  Page Nouveautés — héros éditable + grille de produits 3 par ligne.
  Repli collection : « nouveautes » puis « tous-nos-complements ».
{%- endcomment -%}
{%- assign col = section.settings.collection -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['nouveautes'] -%}{%- endif -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['tous-nos-complements'] -%}{%- endif -%}

{%- comment -%} bannière de saison, comme sur la Sélection d'automne {%- endcomment -%}
{%- if section.settings.image != blank -%}{%- assign nv_img = section.settings.image | image_url: width: 2400 -%}{%- else -%}{%- assign nv_img = 'prov-vignes.jpg' | asset_url -%}{%- endif -%}
<div class="nat-wrap nat-wrap--season" style="padding-top:20px;">
  <div class="nat-season-banner">
    <img class="nat-season-banner__img" src="{{ nv_img }}" alt="{{ section.settings.title | escape }}">
    <div class="nat-season-banner__veil"></div>
    <div class="nat-season-banner__body">
      <h1 class="nat-season-banner__title">{{ section.settings.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="nat-season-banner__sub">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  Bannière puis grille de produits, comme sur la référence. Les blocs servent à
  choisir et à ordonner les produits mis en avant ; à défaut, la collection est
  déroulée telle quelle. Les textes éditoriaux saisis dans les blocs ne sont
  plus affichés — ils restent disponibles dans l'admin.
{%- endcomment -%}
<div class="nat-wrap nat-wrap--season" style="padding-top:16px;padding-bottom:80px;">
  {%- comment -%} gouttieres portees par .nat-grid--season {%- endcomment -%}
  {%- comment -%}
    Les blocs « visuel » sont retires du flux des produits : ils se glissent
    entre les cartes au rang choisi dans l'admin.
  {%- endcomment -%}
  {%- assign prod_blocks = section.blocks | where: 'type', 'item' -%}
  {%- assign visuels = section.blocks | where: 'type', 'visuel' -%}
  <div class="nat-grid-4 nat-grid--products nat-grid--season">
    {%- render 'promo-slot', slot_blocks: visuels, slot_index: 0 -%}
    {%- if prod_blocks.size > 0 -%}
      {%- for block in prod_blocks -%}
        {%- assign bp = block.settings.product -%}
        {%- if bp == blank -%}{%- assign bp = col.products[forloop.index0] -%}{%- endif -%}
        {%- if bp != blank -%}{%- render 'product-card', product: bp -%}{%- endif -%}
        {%- render 'promo-slot', slot_blocks: visuels, slot_index: forloop.index -%}
      {%- endfor -%}
    {%- elsif col != blank and col.products.size > 0 -%}
      {%- for product in col.products limit: 24 -%}
        {%- render 'product-card', product: product -%}
        {%- render 'promo-slot', slot_blocks: visuels, slot_index: forloop.index -%}
      {%- endfor -%}
    {%- else -%}
      <p style="color:var(--brown);">Les nouveautés arrivent très bientôt.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page Nouveautés",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nouveautés" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Nos dernières formules, tout juste arrivées." },
    { "type": "image_picker", "id": "image", "label": "Visuel de la bannière" },
    { "type": "header", "content": "Grille produits" },
    { "type": "collection", "id": "collection", "label": "Collection « Nouveautés »", "info": "Sert de repli si aucune carte n'est ajoutée, ou si une carte n'a pas de produit défini." }
  ],
  "blocks": [
    {
      "type": "item", "name": "Produit + texte",
      "settings": [
        { "type": "header", "content": "Produit" },
        { "type": "product", "id": "product", "label": "Produit à mettre en avant" },
        { "type": "header", "content": "Note interne", "info": "Ces champs ne sont plus affichés sur la page." },
        { "type": "textarea", "id": "text", "label": "Mémo" }
      ]
    },
    {
      "type": "visuel", "name": "Visuel dans la grille",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "position", "label": "Insérer après le … produit", "min": 0, "max": 24, "step": 1, "default": 3, "info": "0 place le visuel avant le premier produit. 3 le place en 4e case." },
        { "type": "select", "id": "span", "label": "Largeur", "default": "1", "options": [{"value":"1","label":"Une colonne"},{"value":"2","label":"Deux colonnes"}] },
        { "type": "header", "content": "Texte (facultatif)", "info": "Laissez vide pour une image seule." },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "text", "label": "Accroche" },
        { "type": "text", "id": "cta", "label": "Libellé du bouton" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "select", "id": "align", "label": "Position du texte", "default": "center", "options": [{"value":"top","label":"En haut"},{"value":"center","label":"Au centre"},{"value":"bottom","label":"En bas"}] },
        { "type": "select", "id": "theme", "label": "Contraste", "default": "light", "options": [{"value":"light","label":"Texte sombre (image claire)"},{"value":"dark","label":"Texte clair sur voile (image sombre)"}] }
      ]
    }
  ],
  "presets": [
    { "name": "Page Nouveautés", "blocks": [
      { "type": "item" },
      { "type": "item" },
      { "type": "item" }
    ] }
  ]
}
{% endschema %}
