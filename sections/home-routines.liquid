{% render 'section-fonts', section: section %}
{%- assign col = section.settings.collection -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['routines'] -%}{%- endif -%}
{%- if col != blank and col.products.size > 0 -%}
<div style="background:var(--pale);">
  <div class="nat-wrap" style="padding-top:64px;padding-bottom:64px;">
    <div class="nat-section-head">
      <div>
        <div class="nat-eyebrow">{{ section.settings.eyebrow | default: 'Offres groupées' }}</div>
        <h2 class="nat-h2" style="margin-top:8px;">{{ section.settings.title | default: 'Nos routines' }}</h2>
      </div>
      <a class="nat-link" href="{{ col.url }}">Toutes les routines →</a>
    </div>
    <p style="font-size:14.5px;color:var(--brown);margin:10px 0 30px;max-width:560px;">{{ section.settings.subtitle | default: 'Des cures complètes, pensées ensemble et à prix réduit.' }}</p>
    <div class="nat-grid-3">
      {%- for product in col.products limit: 3 -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Routines (accueil)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Offres groupées" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos routines" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Des cures complètes, pensées ensemble et à prix réduit." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Par défaut : Routines" },
    { "type": "header", "content": "Polices (cette section)" },
    { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
    { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
  ],
  "presets": [ { "name": "Routines (accueil)" } ]
}
{% endschema %}
