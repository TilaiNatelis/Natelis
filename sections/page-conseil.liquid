{% render 'section-fonts', section: section %}
{%- comment -%}
  Pages conseils thématiques (Vitalité & immunité, Beauté & sommeil, Sport & bien-être).
  Même structure que « Tous nos conseils » mais resserrée sur la rubrique :
    1. en-tête
    2. deux rayons : conseils généraux, puis conseils liés aux produits
    3. les compléments de la rubrique
    4. renvoi vers tous nos conseils
  La rubrique est déduite du handle de page ; les réglages de section permettent
  de surcharger les thématiques (tags) sans toucher au code.
{%- endcomment -%}
{%- assign h = page.handle -%}
{%- if h contains 'vitalite' -%}
  {%- assign d_tag1 = 'Saison' -%}{%- assign d_tag2 = 'Conseils' -%}
  {%- assign coll = 'vitalite-immunite' -%}{%- assign hero = 'prov-vignes.jpg' -%}
  {%- assign sub = 'Vitalité & immunité' -%}
  {%- assign intro = 'Renforcez vos défenses et votre énergie avec les bons actifs, formulés en Provence.' -%}
{%- elsif h contains 'beaute' -%}
  {%- assign d_tag1 = 'Beauté' -%}{%- assign d_tag2 = 'Bien-être' -%}
  {%- assign coll = 'beaute-sommeil' -%}{%- assign hero = 'prov-lavande.jpg' -%}
  {%- assign sub = 'Beauté & sommeil' -%}
  {%- assign intro = 'Sublimez votre peau et retrouvez des nuits sereines, naturellement.' -%}
{%- elsif h contains 'sport' -%}
  {%- assign d_tag1 = 'Énergie' -%}{%- assign d_tag2 = 'Conseils' -%}
  {%- assign coll = 'sport-bien-etre' -%}{%- assign hero = 'prov-calanque.jpg' -%}
  {%- assign sub = 'Sport & bien-être' -%}
  {%- assign intro = 'Récupération, articulations et équilibre : les compléments qui accompagnent votre activité.' -%}
{%- else -%}
  {%- assign d_tag1 = 'Conseils' -%}{%- assign d_tag2 = 'Bien-être' -%}
  {%- assign coll = 'tous-nos-complements' -%}{%- assign hero = 'prov-vignes.jpg' -%}
  {%- assign sub = 'Conseils' -%}
  {%- assign intro = 'Nos conseils pour composer votre cure idéale.' -%}
{%- endif -%}

{%- assign tag1 = section.settings.tag1 | default: d_tag1 -%}
{%- assign tag2 = section.settings.tag2 | default: d_tag2 -%}
{%- assign collection = collections[coll] -%}
{%- assign cblog = blogs[section.settings.blog] -%}
{%- if cblog == blank or cblog.articles_count == 0 -%}{%- assign cblog = blogs['carnet-de-la-vigne'] -%}{%- endif -%}
{%- if section.settings.hero_image != blank -%}{%- assign hero_src = section.settings.hero_image | image_url: width: 1200 -%}{%- else -%}{%- assign hero_src = hero | asset_url -%}{%- endif -%}

<!-- en-tête -->
<div style="background:var(--pale);">
  <div style="max-width:920px;margin:0 auto;padding:64px 48px 56px;text-align:center;">
    <div class="nat-eyebrow" style="letter-spacing:.28em;">Le guide Natélis · {{ sub }}</div>
    <h1 class="nat-serif" style="font-size:54px;line-height:1.04;margin:16px 0 0;">{{ page.title }}</h1>
    <p style="font-size:16.5px;line-height:1.7;color:var(--green-text);margin:16px auto 0;max-width:600px;">{{ intro }}</p>
  </div>
</div>

{%- comment -%}
  Le corps de page (Admin > Pages > contenu) n'est volontairement pas affiché :
  ces pages se limitent aux deux rayons, aux produits de la rubrique et aux
  deux renvois. Le texte reste conservé dans l'admin.
{%- endcomment -%}

<!-- deux rayons de conseils : généraux, puis liés aux produits -->
{%- comment -%} render n'accepte pas de filtres dans ses arguments : on précalcule {%- endcomment -%}
{%- assign r1_title = section.settings.rail1_title | default: 'Nos conseils' -%}
{%- assign r2_title = section.settings.rail2_title | default: 'Bien utiliser nos compléments' -%}
{%- assign r2_sub = section.settings.rail2_sub | default: 'Posologie, associations et bonnes pratiques, produit par produit.' -%}
<div class="nat-wrap" style="padding-bottom:16px;">
  {%- render 'conseil-rail',
        rail_blog: cblog,
        rail_tag: tag1,
        rail_title: r1_title,
        rail_sub: section.settings.rail1_sub,
        rail_limit: 12,
        rail_chips: 'false',
        rail_id: 'r1' -%}

  {%- render 'conseil-rail',
        rail_blog: cblog,
        rail_tag: tag2,
        rail_title: r2_title,
        rail_sub: r2_sub,
        rail_limit: 12,
        rail_chips: 'false',
        rail_id: 'r2' -%}
</div>

<!-- les compléments de la rubrique -->
{%- if collection != blank and collection.products.size > 0 -%}
<div class="nat-wrap" style="padding-top:56px;padding-bottom:8px;">
  <div class="nat-section-head">
    <div>
      <p class="nat-section-head__eyebrow">{{ sub }}</p>
      <h2 class="nat-h2">Les compléments conseillés</h2>
    </div>
    <a class="nat-link" href="{{ collection.url }}">Voir tout →</a>
  </div>
  <div class="nat-grid-3 nat-grid--products" style="gap:34px 26px;margin-top:32px;">
    {%- for product in collection.products limit: 6 -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

<!-- renvoi vers tous nos conseils -->
<div class="nat-wrap" style="padding-top:64px;padding-bottom:80px;">
  <div class="nat-conseil-cta">
    <div class="nat-conseil-cta__media" style="background-image:url('{{ hero_src }}');"></div>
    <div class="nat-conseil-cta__body">
      <p class="nat-section-head__eyebrow">Le guide Natélis</p>
      <h2 class="nat-serif" style="font-size:34px;line-height:1.1;margin:0 0 12px;">Explorer tous nos conseils</h2>
      <p style="font-size:15px;line-height:1.7;color:var(--brown-dark);margin:0 0 24px;max-width:460px;">Immunité, sommeil, beauté, énergie, terroir : retrouvez l'ensemble de nos articles, classés par thématique.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a class="nat-btn" href="{{ section.settings.all_url | default: '/pages/conseils' }}">Tous nos conseils</a>
        <a class="nat-btn nat-btn--outline" href="{{ section.settings.diag_url | default: '/pages/diagnostic' }}">Faire mon diagnostic</a>
      </div>
    </div>
  </div>
</div>

<script>
  (function(){
    // flèches de défilement des rayons (identiques à la page « Tous nos conseils »)
    document.querySelectorAll('.nat-rail__viewport').forEach(function(vp){
      var track = vp.querySelector('.nat-rail__track');
      var prev  = vp.querySelector('.nat-rail__arrow--prev');
      var next  = vp.querySelector('.nat-rail__arrow--next');
      if(!track || !prev || !next) return;

      function step(){
        var card = track.querySelector('.nat-pcard');
        var gap  = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 18;
        return card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
      }
      function refresh(){
        var max = track.scrollWidth - track.clientWidth - 2;
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = max <= 0 || track.scrollLeft >= max;
      }
      [prev, next].forEach(function(btn){
        btn.addEventListener('click', function(){
          track.scrollBy({ left: step() * parseInt(btn.dataset.dir, 10), behavior: 'smooth' });
        });
      });
      track.addEventListener('scroll', refresh, { passive: true });
      window.addEventListener('resize', refresh);
      refresh();
    });
  })();
</script>

{% schema %}
{
  "name": "Page Conseil thématique",
  "settings": [
    { "type": "header", "content": "Polices (cette section)" },
    { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
    { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] },
    { "type": "header", "content": "Source des articles" },
    { "type": "blog", "id": "blog", "label": "Blog des conseils" },
    { "type": "header", "content": "Rayon 1 — conseils généraux" },
    { "type": "text", "id": "rail1_title", "label": "Titre", "default": "Nos conseils" },
    { "type": "text", "id": "rail1_sub", "label": "Sous-titre" },
    { "type": "text", "id": "tag1", "label": "Thématique (tag d'article)", "info": "Vide = thématique déduite de la page." },
    { "type": "header", "content": "Rayon 2 — conseils produits" },
    { "type": "text", "id": "rail2_title", "label": "Titre", "default": "Bien utiliser nos compléments" },
    { "type": "text", "id": "rail2_sub", "label": "Sous-titre", "default": "Posologie, associations et bonnes pratiques, produit par produit." },
    { "type": "text", "id": "tag2", "label": "Thématique (tag d'article)", "info": "Vide = thématique déduite de la page." },
    { "type": "header", "content": "Bas de page" },
    { "type": "image_picker", "id": "hero_image", "label": "Image du bloc de renvoi" },
    { "type": "url", "id": "all_url", "label": "Lien « Tous nos conseils »" },
    { "type": "url", "id": "diag_url", "label": "Lien diagnostic" }
  ]
}
{% endschema %}
