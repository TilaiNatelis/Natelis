{%- comment -%} Colonnes par défaut si aucun bloc/menu n'est configuré {%- endcomment -%}
{%- assign has_configured_blocks = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.menu != blank -%}{%- assign has_configured_blocks = true -%}{%- endif -%}
{%- endfor -%}

<div class="nat-footer">
  <div>
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | image_url: height: 88 }}" alt="{{ shop.name }}" height="44" style="display:block;">
    {%- else -%}
      <span class="nat-logo-text" style="font-size:34px;">Natélis</span>
    {%- endif -%}
    <p class="nat-footer__desc">{{ section.settings.description }}</p>
  </div>

  {%- if has_configured_blocks -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="nat-footer__col-title">{{ block.settings.title }}</div>
        {%- if block.settings.menu != blank -%}
          {%- for link in linklists[block.settings.menu].links -%}
            <a class="nat-footer__link" href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- else -%}
    <div>
      <div class="nat-footer__col-title">Produits</div>
      <a class="nat-footer__link" href="{{ routes.root_url }}collections/immunite">Immunité</a>
      <a class="nat-footer__link" href="{{ routes.root_url }}collections/sommeil">Sommeil</a>
      <a class="nat-footer__link" href="{{ routes.root_url }}collections/stress">Stress</a>
      <a class="nat-footer__link" href="{{ routes.root_url }}collections/beaute">Beauté</a>
      <a class="nat-footer__link" href="{{ routes.root_url }}collections/energie">Énergie</a>
    </div>
    <div>
      <div class="nat-footer__col-title">La marque</div>
      <a class="nat-footer__link" href="{{ routes.root_url }}pages/conseils">Nos conseils</a>
      <a class="nat-footer__link" href="{{ routes.root_url }}pages/diagnostic">Diagnostic</a>
      <a class="nat-footer__link" href="{{ blogs['carnet-de-la-vigne'].url | default: routes.root_url }}">Le blog</a>
      <a class="nat-footer__link" href="{{ routes.root_url }}pages/selection-automne">Sélection d'automne</a>
    </div>
    <div>
      <div class="nat-footer__col-title">Aide</div>
      <a class="nat-footer__link" href="{{ routes.root_url }}pages/contact">Contact</a>
      <a class="nat-footer__link" href="{{ routes.account_url | default: routes.account_login_url }}">Mon compte &amp; suivi de cure</a>
      <a class="nat-footer__link" href="{{ routes.search_url }}">Recherche</a>
      <a class="nat-footer__link" href="{{ routes.cart_url }}">Mon panier</a>
    </div>
  {%- endif -%}
</div>

<div class="nat-footer__legal">
  <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} en Provence</span>
  <span>Mentions légales · CGV · Confidentialité</span>
</div>

{% schema %}
{
  "name": "Pied de page",
  "max_blocks": 3,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Compléments alimentaires d'origine naturelle, formulés en Provence. Le retour à l'état originel de la plante." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Colonne de liens",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
