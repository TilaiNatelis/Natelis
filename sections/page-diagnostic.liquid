{% render 'section-fonts', section: section %}
{%- assign col = section.settings.collection -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['tous-nos-complements'] -%}{%- endif -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections.all -%}{%- endif -%}

<section class="nat-finder" id="NatDiag-{{ section.id }}">

  <!-- intro -->
  <div class="nat-finder__stage nat-finder__stage--intro" data-step="intro">
    <div class="nat-finder__introbox">
      <div class="nat-finder__eyebrow">{{ section.settings.intro_eyebrow }}</div>
      <h1 class="nat-finder__title">{{ section.settings.intro_title }}</h1>
      <p class="nat-finder__lede">{{ section.settings.intro_text }}</p>

      <div class="nat-finder__steps">
        {%- assign labels = 'Objectif,Ressenti,Rythme,Nuits,Depuis quand,Priorité' | split: ',' -%}
        {%- for l in labels -%}
          <div class="nat-finder__stepchip"><span>{{ forloop.index }}</span>{{ l }}</div>
        {%- endfor -%}
      </div>

      <div class="nat-finder__name">
        <label for="NatDiagName-{{ section.id }}">Votre prénom (facultatif)</label>
        <input type="text" id="NatDiagName-{{ section.id }}" data-el="name" autocomplete="given-name" placeholder="Pour personnaliser votre cure">
      </div>

      <div style="margin-top:28px;">
        <button type="button" class="nat-finder__cta" data-action="start">{{ section.settings.start_label }}</button>
      </div>
      <p class="nat-finder__note">{{ section.settings.intro_note }}</p>
    </div>
  </div>

  <!-- question -->
  <div class="nat-finder__stage" data-step="question" style="display:none;">
    <div class="nat-finder__topbar">
      <div class="nat-finder__steplabel" data-el="stepname"></div>
      <div class="nat-finder__progress"><span data-el="bar"></span></div>
    </div>
    <div class="nat-finder__main">
      <h2 class="nat-finder__q" data-el="question"></h2>
      <div class="nat-finder__options" data-el="options"></div>
    </div>
    <div class="nat-finder__nav">
      <button type="button" class="nat-finder__back" data-action="back">← Précédent</button>
      <button type="button" class="nat-finder__next" data-action="next" disabled>
        <span class="nat-finder__next-arrow">→</span>
        <span class="nat-finder__next-labels"><strong data-el="nextname">Suivant</strong><em>Suivant</em></span>
      </button>
    </div>
  </div>

  <!-- résultat : la cure -->
  <div class="nat-finder__stage nat-finder__stage--result" data-step="result" style="display:none;">
    <div class="nat-finder__result-head">
      <div class="nat-finder__eyebrow">Votre cure sur-mesure</div>
      <h1 class="nat-finder__title" data-el="recTitle"></h1>
      <div class="nat-finder__prios" data-el="recPrios"></div>
      <div class="nat-finder__recap" data-el="recRecap"></div>
    </div>

    <div class="nat-finder__blockhead">
      <h2 class="nat-finder__blocktitle" data-el="cureTitle">Votre cure</h2>
      <p class="nat-finder__blocksub" data-el="cureSub"></p>
    </div>
    <div class="nat-cure-list" data-el="recProducts"></div>
    <div data-el="recEmpty" style="display:none;margin-top:24px;">
      <a class="nat-btn" href="{{ routes.all_products_collection_url }}">Voir tous nos compléments</a>
    </div>

    <div class="nat-finder__blockhead">
      <h2 class="nat-finder__blocktitle">Votre rituel au quotidien</h2>
      <p class="nat-finder__blocksub">Quand prendre chaque complément pour en tirer le meilleur.</p>
    </div>
    <div class="nat-ritual">
      <div class="nat-ritual__col">
        <div class="nat-ritual__when">Le matin</div>
        <div class="nat-ritual__title">Au petit-déjeuner</div>
        <ul class="nat-ritual__list" data-el="ritualAm"></ul>
        <p class="nat-ritual__empty" data-el="ritualAmEmpty" style="display:none;">Rien le matin dans votre cure.</p>
      </div>
      <div class="nat-ritual__col">
        <div class="nat-ritual__when">Le soir</div>
        <div class="nat-ritual__title">Au dîner ou au coucher</div>
        <ul class="nat-ritual__list" data-el="ritualPm"></ul>
        <p class="nat-ritual__empty" data-el="ritualPmEmpty" style="display:none;">Rien le soir dans votre cure.</p>
      </div>
    </div>

    <div class="nat-finder__total">
      <div class="nat-finder__total-label">
        <span data-el="totalCount"></span>
        <strong data-el="totalPrice"></strong>
      </div>
      <button type="button" class="nat-finder__cta" data-action="addRoutine">Ajouter ma cure au panier</button>
    </div>

    <div class="nat-finder__result-actions">
      <button type="button" class="nat-finder__ghost" data-action="restart">Refaire le diagnostic</button>
    </div>
    <p class="nat-finder__note">{{ section.settings.result_note }}</p>
  </div>

</section>

<script>
(function(){
  var root = document.getElementById('NatDiag-{{ section.id }}');
  if(!root) return;

  var PRODUCTS = [
    {%- for product in col.products -%}
      {%- assign vid = product.selected_or_first_available_variant.id | default: product.variants.first.id -%}
      {%- if vid != blank -%}
      { vid: {{ vid }}, title: {{ product.title | json }}, url: {{ product.url | json }},
        price: {{ product.price | money | json }}, cents: {{ product.price | default: 0 }},
        img: {{ product.featured_image | image_url: width: 500 | json }},
        sub: {{ product.metafields.custom.subtitle.value | default: '' | json }},
        dosage: {{ product.metafields.custom.dosage_text.value | default: '' | json }},
        objs: {{ product.tags | json }} },
      {%- endif -%}
    {%- endfor -%}
  ];

  // Chaque réponse alimente un ou plusieurs objectifs, avec un poids décroissant
  // selon l'importance de la question. `phrase` sert à rédiger le récapitulatif.
  var QUESTIONS = [
    { key:'q1', name:'Objectif', q:'Quel est votre objectif principal ?', w:3, options:[
      {label:'Renforcer mon immunité', note:'Passer la saison sans faiblir', phrase:'renforcer votre immunité', objs:['Immunité']},
      {label:'Mieux dormir', note:'Endormissement et nuits réparatrices', phrase:'retrouver un sommeil réparateur', objs:['Sommeil']},
      {label:'Apaiser mon stress', note:'Tension nerveuse, irritabilité', phrase:'apaiser votre stress', objs:['Stress']},
      {label:'Retrouver de l’énergie', note:'Coups de fatigue, baisse de tonus', phrase:'retrouver de l’énergie', objs:['Énergie']},
      {label:'Peau, cheveux & ongles', note:'Éclat et fermeté', phrase:'prendre soin de votre peau et de vos cheveux', objs:['Beauté']},
      {label:'Confort articulaire', note:'Souplesse et mobilité', phrase:'retrouver du confort articulaire', objs:['Articulations']},
      {label:'Confort digestif', note:'Transit et équilibre de la flore', phrase:'retrouver un confort digestif', objs:['Digestion']}
    ]},
    { key:'q2', name:'Ressenti', q:'Qu’est-ce qui vous gêne le plus en ce moment ?', w:2, options:[
      {label:'Des coups de fatigue', note:'Surtout en fin de journée', phrase:'Ce sont surtout les coups de fatigue qui pèsent', objs:['Énergie','Immunité']},
      {label:'De la tension nerveuse', note:'Difficile de redescendre', phrase:'La tension nerveuse est ce qui vous gêne le plus', objs:['Stress']},
      {label:'Des nuits agitées', note:'Réveils nocturnes fréquents', phrase:'Vos nuits sont agitées et peu réparatrices', objs:['Sommeil','Stress']},
      {label:'Un teint terne', note:'Cheveux et ongles fragiles', phrase:'Votre teint et vos cheveux manquent d’éclat', objs:['Beauté']},
      {label:'Des ballonnements', note:'Transit irrégulier', phrase:'Votre digestion manque de confort', objs:['Digestion']},
      {label:'Des raideurs articulaires', note:'Au réveil ou après l’effort', phrase:'Les raideurs articulaires vous limitent au quotidien', objs:['Articulations']},
      {label:'Des rhumes à répétition', note:'Défenses en berne', phrase:'Vos défenses immunitaires semblent à plat', objs:['Immunité']}
    ]},
    { key:'q3', name:'Rythme', q:'Quel est votre rythme de vie ?', w:1, options:[
      {label:'Sportif·ve régulier·e', note:'Plusieurs séances par semaine', phrase:'dans un rythme sportif soutenu', objs:['Articulations','Énergie']},
      {label:'Vie professionnelle intense', note:'Charge mentale élevée', phrase:'dans un quotidien professionnel intense', objs:['Stress','Énergie']},
      {label:'Beaucoup d’écrans', note:'Journées devant un écran', phrase:'avec beaucoup de temps passé devant les écrans', objs:['Sommeil','Stress']},
      {label:'Plutôt sédentaire', note:'Peu d’activité physique', phrase:'dans un quotidien plutôt sédentaire', objs:['Énergie','Digestion']},
      {label:'Un rythme équilibré', note:'Activité modérée et régulière', phrase:'dans un rythme globalement équilibré', objs:['Énergie']}
    ]},
    { key:'q4', name:'Nuits', q:'Comment sont vos nuits ?', w:2, options:[
      {label:'J’ai du mal à m’endormir', note:'Plus de 30 minutes', phrase:'l’endormissement reste difficile', objs:['Sommeil','Stress']},
      {label:'Je me réveille fatigué·e', note:'Sommeil peu réparateur', phrase:'les réveils sont difficiles', objs:['Énergie','Sommeil']},
      {label:'Correctes, mais perfectibles', note:'Quelques nuits courtes', phrase:'vos nuits sont correctes sans être optimales', objs:['Sommeil']},
      {label:'Je dors très bien', note:'Sommeil régulier et réparateur', phrase:'votre sommeil est déjà un point fort', objs:[]}
    ]},
    { key:'q5', name:'Depuis quand', q:'Depuis combien de temps ressentez-vous cela ?', w:1, options:[
      {label:'Quelques jours', note:'C’est récent', phrase:'depuis quelques jours seulement', dur:1, objs:[]},
      {label:'Quelques semaines', note:'Cela s’installe', phrase:'depuis plusieurs semaines', dur:2, objs:[]},
      {label:'Plusieurs mois', note:'C’est durable', phrase:'depuis plusieurs mois', dur:3, objs:[]},
      {label:'C’est récurrent', note:'Cela revient chaque année', phrase:'de façon récurrente', dur:3, objs:[]}
    ]},
    { key:'q6', name:'Priorité', q:'Votre priorité pour les prochaines semaines ?', w:1, options:[
      {label:'Passer l’hiver en forme', note:'Sans tomber malade', phrase:'passer la saison en pleine forme', objs:['Immunité']},
      {label:'Retrouver de l’éclat', note:'Peau, cheveux, ongles', phrase:'retrouver de l’éclat', objs:['Beauté']},
      {label:'Plus de calme', note:'Sérénité et détente', phrase:'gagner en calme et en sérénité', objs:['Stress','Sommeil']},
      {label:'Un regain de vitalité', note:'Du tonus au quotidien', phrase:'retrouver un vrai regain de vitalité', objs:['Énergie']},
      {label:'Une digestion légère', note:'Confort au quotidien', phrase:'retrouver une digestion légère', objs:['Digestion']}
    ]}
  ];

  // Objectifs pris plutôt le soir ; les autres se prennent le matin.
  var EVENING = ['Sommeil','Stress'];
  // Objectifs dont les effets s'installent lentement : cure plus longue.
  var SLOW = ['Beauté','Articulations'];

  var step = 0, answers = {}, recVids = [], firstName = '';

  function $(s){ return root.querySelector(s); }
  function panel(n){ return root.querySelector('[data-step="'+n+'"]'); }
  function show(n){
    ['intro','question','result'].forEach(function(p){ panel(p).style.display = (p===n)?'':'none'; });
    try{ root.scrollIntoView({behavior:'smooth', block:'start'}); }catch(e){ window.scrollTo(0,0); }
  }
  function esc(s){ var d=document.createElement('div'); d.textContent = s==null?'':String(s); return d.innerHTML; }

  function renderQuestion(){
    var q = QUESTIONS[step-1];
    $('[data-el="stepname"]').textContent = 'Étape ' + step + ' sur ' + QUESTIONS.length + ' · ' + q.name;
    $('[data-el="bar"]').style.width = Math.round(step/QUESTIONS.length*100)+'%';
    $('[data-el="question"]').textContent = q.q;

    var box = $('[data-el="options"]'); box.innerHTML='';
    box.setAttribute('data-count', q.options.length);
    q.options.forEach(function(o,i){
      var b = document.createElement('button');
      b.type='button'; b.className='nat-finder__opt' + (answers[q.key]===i ? ' is-selected' : '');
      b.innerHTML = '<span class="nat-finder__opt-label">'+esc(o.label)+'</span>'+
                    (o.note ? '<span class="nat-finder__opt-note">'+esc(o.note)+'</span>' : '')+
                    '<span class="nat-finder__opt-check">✓</span>';
      b.addEventListener('click', function(){
        answers[q.key]=i;
        Array.prototype.forEach.call(box.children, function(c){ c.classList.remove('is-selected'); });
        b.classList.add('is-selected');
        updateNav();
      });
      box.appendChild(b);
    });
    updateNav();
    show('question');
  }

  function updateNav(){
    var q = QUESTIONS[step-1];
    var nextBtn = root.querySelector('[data-action="next"]');
    nextBtn.disabled = answers[q.key] == null;
    $('[data-el="nextname"]').textContent = (step < QUESTIONS.length) ? QUESTIONS[step].name : 'Ma cure';
    root.querySelector('[data-action="back"]').style.visibility = (step>1) ? 'visible' : 'hidden';
  }

  function goNext(){
    if(answers[QUESTIONS[step-1].key] == null) return;
    step++;
    if(step > QUESTIONS.length){ finish(); } else { renderQuestion(); }
  }

  function pick(qi){ var q=QUESTIONS[qi]; var a=answers[q.key]; return (a!=null) ? q.options[a] : null; }

  function money(cents){
    try{ return (cents/100).toLocaleString('fr-FR',{minimumFractionDigits:2,maximumFractionDigits:2}) + ' €'; }
    catch(e){ return (cents/100).toFixed(2) + ' €'; }
  }

  function finish(){
    // 1. score des objectifs
    var score = {};
    QUESTIONS.forEach(function(q){
      var ai = answers[q.key];
      if(ai!=null && q.options[ai]){ q.options[ai].objs.forEach(function(o){ score[o]=(score[o]||0)+q.w; }); }
    });
    var ranked = Object.keys(score).sort(function(a,b){ return score[b]-score[a]; });
    var top = ranked.slice(0,2);

    // 2. durée de cure : ancienneté du besoin, allongée si objectif lent
    var durOpt = pick(4);
    var months = durOpt && durOpt.dur ? durOpt.dur : 2;
    if(top.some(function(o){ return SLOW.indexOf(o) > -1; })) months = Math.max(months, 3);
    if(months < 1) months = 1;

    // 3. sélection des produits
    var scored = PRODUCTS.map(function(p){
      var s = 0, why = '';
      p.objs.forEach(function(o){ if(score[o]){ s += score[o]; if(!why || score[o] > score[why]) why = o; } });
      return { p:p, s:s, why:why };
    }).filter(function(x){ return x.s > 0; })
      .sort(function(a,b){ return b.s - a.s; });

    var chosen = scored.slice(0,4);
    if(chosen.length < 3){
      PRODUCTS.forEach(function(p){
        if(chosen.length < 3 && !chosen.some(function(x){ return x.p.vid===p.vid; })){ chosen.push({ p:p, s:0, why:top[0]||'' }); }
      });
    }
    recVids = chosen.map(function(x){ return x.p.vid; });

    // 4. titre personnalisé + priorités
    var hi = firstName ? ('Votre cure, ' + firstName) : 'Votre cure sur-mesure';
    $('[data-el="recTitle"]').textContent = hi;

    var prios = $('[data-el="recPrios"]'); prios.innerHTML='';
    (top.length ? top : ['Vitalité']).forEach(function(o,i){
      var s=document.createElement('span');
      s.className = 'nat-finder__prio' + (i>0 ? ' nat-finder__prio--alt' : '');
      s.textContent = (i===0 ? 'Priorité : ' : 'Puis : ') + o;
      prios.appendChild(s);
    });

    // 5. récapitulatif rédigé à partir des réponses
    var o1=pick(0), o2=pick(1), o3=pick(2), o4=pick(3), o5=pick(4), o6=pick(5);
    var who = firstName ? (firstName + ', vous') : 'Vous';
    var txt = who + ' souhaitez avant tout ' + (o1?o1.phrase:'prendre soin de vous') +
              (o5 ? ', et cela dure ' + o5.phrase : '') + '. ' +
              (o2 ? o2.phrase : '') + (o3 ? ', ' + o3.phrase : '') + '. ' +
              (o4 ? 'Côté nuits, ' + o4.phrase + '. ' : '') +
              (o6 ? 'Pour les prochaines semaines, votre priorité est de ' + o6.phrase + '.' : '');
    $('[data-el="recRecap"]').textContent = txt.replace(/\s+([.,])/g, '$1').replace(/\.\s*\./g, '.');

    // 6. la cure, produit par produit
    $('[data-el="cureTitle"]').textContent = 'Votre cure en ' + chosen.length + ' compléments';
    $('[data-el="cureSub"]').textContent = 'À suivre sur ' + months + ' mois' +
      (months >= 3 ? ' — les effets sur ce type d’objectif s’installent progressivement.' : ', puis à réévaluer.');

    var list = $('[data-el="recProducts"]'); list.innerHTML='';
    if(chosen.length===0){
      list.style.display='none'; $('[data-el="recEmpty"]').style.display='block';
    } else {
      list.style.display=''; $('[data-el="recEmpty"]').style.display='none';
      chosen.forEach(function(x,i){
        var p=x.p;
        var evening = p.objs.some(function(o){ return EVENING.indexOf(o) > -1; });
        var moment = evening ? 'Le soir' : 'Le matin';
        var why = x.why ? ('Retenu pour votre objectif ' + x.why.toLowerCase() + '.') : 'Complément de fond pour équilibrer la cure.';
        if(p.sub) why += ' ' + p.sub + (/[.!?…]$/.test(p.sub) ? '' : '.');

        var el=document.createElement('div'); el.className='nat-cure-item';
        el.innerHTML =
          '<a class="nat-cure-item__media" href="'+p.url+'">'+(p.img?'<img src="'+p.img+'" alt="">':'')+'</a>'+
          '<div class="nat-cure-item__body">'+
            '<div class="nat-cure-item__rank">Étape '+(i+1)+' de votre cure</div>'+
            '<a class="nat-cure-item__name" href="'+p.url+'">'+esc(p.title)+'</a>'+
            '<p class="nat-cure-item__why">'+esc(why)+'</p>'+
            '<div class="nat-cure-item__specs">'+
              '<span class="nat-cure-item__spec">'+moment+'</span>'+
              '<span class="nat-cure-item__spec">Cure de '+months+' mois</span>'+
              (p.dosage ? '<span class="nat-cure-item__spec">'+esc(p.dosage)+'</span>' : '')+
            '</div>'+
          '</div>'+
          '<div class="nat-cure-item__buy">'+
            '<span class="nat-cure-item__price">'+esc(p.price)+'</span>'+
            '<button type="button" class="nat-card__add" data-action="addOne" data-vid="'+p.vid+'">Ajouter</button>'+
          '</div>';
        list.appendChild(el);
      });
    }

    // 7. rituel matin / soir
    var am=$('[data-el="ritualAm"]'), pm=$('[data-el="ritualPm"]');
    am.innerHTML=''; pm.innerHTML='';
    chosen.forEach(function(x){
      var p=x.p;
      var evening = p.objs.some(function(o){ return EVENING.indexOf(o) > -1; });
      var li=document.createElement('li');
      li.innerHTML = '<span>✦</span>' + esc(p.title) + (p.dosage ? ' — ' + esc(p.dosage) : '');
      (evening ? pm : am).appendChild(li);
    });
    $('[data-el="ritualAmEmpty"]').style.display = am.children.length ? 'none' : '';
    $('[data-el="ritualPmEmpty"]').style.display = pm.children.length ? 'none' : '';

    // 8. total
    var total = chosen.reduce(function(s,x){ return s + (x.p.cents||0); }, 0);
    $('[data-el="totalCount"]').textContent = chosen.length + ' compléments · cure de ' + months + ' mois';
    $('[data-el="totalPrice"]').textContent = money(total) + ' le premier mois';

    show('result');
  }

  function addToCart(items, go, btn){
    if(!items.length) return;
    fetch('/cart/add.js', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({items:items})})
      .then(function(r){ return r.json(); })
      .then(function(){ if(go){ window.location.href='/cart'; } else if(btn){ btn.textContent='Ajouté ✓'; setTimeout(function(){ btn.textContent='Ajouter'; },1600); } })
      .catch(function(){ if(btn){ btn.textContent='Réessayer'; } });
  }

  root.addEventListener('click', function(e){
    var a = e.target.closest('[data-action]'); if(!a) return;
    var act = a.getAttribute('data-action');
    if(act==='start'){
      var f = root.querySelector('[data-el="name"]');
      firstName = f && f.value ? f.value.trim().slice(0,24) : '';
      step=1; answers={}; renderQuestion();
    }
    else if(act==='restart'){ step=0; answers={}; show('intro'); }
    else if(act==='back'){ if(step>1){ step--; renderQuestion(); } }
    else if(act==='next'){ goNext(); }
    else if(act==='addOne'){ addToCart([{id:parseInt(a.getAttribute('data-vid'),10), quantity:1}], false, a); }
    else if(act==='addRoutine'){ addToCart(recVids.map(function(v){ return {id:v, quantity:1}; }), true); }
  });

  // Entrée dans le champ prénom = démarrer
  var nameInput = root.querySelector('[data-el="name"]');
  if(nameInput){
    nameInput.addEventListener('keydown', function(e){
      if(e.key==='Enter'){ e.preventDefault(); root.querySelector('[data-action="start"]').click(); }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Page Diagnostic",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "header", "content": "Introduction" },
    { "type": "text", "id": "intro_eyebrow", "label": "Sur-titre", "default": "Diagnostic personnalisé" },
    { "type": "text", "id": "intro_title", "label": "Titre", "default": "Composons votre cure ensemble" },
    { "type": "textarea", "id": "intro_text", "label": "Texte d'intro", "default": "Six questions sur votre objectif, votre ressenti et votre rythme de vie. Nous en tirons une cure précise : quels compléments, à quel moment de la journée, et pour combien de temps." },
    { "type": "text", "id": "start_label", "label": "Bouton de démarrage", "default": "Commencer le diagnostic" },
