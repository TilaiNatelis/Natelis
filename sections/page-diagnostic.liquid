{% render 'section-fonts', section: section %}
{%- assign col = section.settings.collection -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['tous-nos-complements'] -%}{%- endif -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections.all -%}{%- endif -%}

<section class="nat-finder" id="NatDiag-{{ section.id }}">

  <!-- intro -->
  <div class="nat-finder__stage nat-finder__stage--intro" data-step="intro">
    <div class="nat-finder__introbox">
      <div class="nat-finder__eyebrow">{{ section.settings.intro_eyebrow | default: 'Diagnostic personnalisé' }}</div>
      <h1 class="nat-finder__title">{{ section.settings.intro_title | default: 'Trouvez votre cure idéale' }}</h1>
      <p class="nat-finder__lede">{{ section.settings.intro_text | default: 'Répondez à 3 questions sur vos besoins et votre mode de vie. Nous composons une routine de compléments sur-mesure, en quelques secondes.' }}</p>
      <div class="nat-finder__steps">
        {%- assign labels = 'Objectif,Ressenti,Mode de vie' | split: ',' -%}
        {%- for l in labels -%}
          <div class="nat-finder__stepchip"><span>{{ forloop.index }}</span>{{ l }}</div>
        {%- endfor -%}
      </div>
      <button type="button" class="nat-finder__cta" data-action="start">{{ section.settings.start_label | default: 'Commencer le diagnostic' }}</button>
    </div>
  </div>

  <!-- question -->
  <div class="nat-finder__stage" data-step="question" style="display:none;">
    <div class="nat-finder__topbar">
      <div class="nat-finder__steplabel" data-el="stepname"></div>
      <div class="nat-finder__progress"><span data-el="bar"></span></div>
    </div>
    <div class="nat-finder__main">
      <h2 class="nat-finder__q" data-el="question"></h2>
      <div class="nat-finder__options" data-el="options"></div>
    </div>
    <div class="nat-finder__nav">
      <button type="button" class="nat-finder__back" data-action="back">← Précédent</button>
      <button type="button" class="nat-finder__next" data-action="next" disabled>
        <span class="nat-finder__next-arrow">→</span>
        <span class="nat-finder__next-labels"><strong data-el="nextname">Suivant</strong><em>Suivant</em></span>
      </button>
    </div>
  </div>

  <!-- résultat -->
  <div class="nat-finder__stage nat-finder__stage--result" data-step="result" style="display:none;">
    <div class="nat-finder__result-head">
      <div class="nat-finder__eyebrow">Votre routine sur-mesure</div>
      <h1 class="nat-finder__title">Recommandé&nbsp;: <span data-el="recTitle"></span></h1>
      <p class="nat-finder__lede">Voici les compléments les plus adaptés à vos réponses. Ajoutez-les à l'unité ou composez toute la routine en un clic.</p>
    </div>
    <div class="nat-finder__panel">
      <div class="nat-grid-4" data-el="recProducts" style="gap:22px;"></div>
      <div data-el="recEmpty" style="display:none;text-align:center;">
        <a class="nat-btn" href="{{ routes.all_products_collection_url }}">Voir tous nos compléments</a>
      </div>
    </div>
    <div class="nat-finder__result-actions">
      <button type="button" class="nat-finder__cta" data-action="addRoutine">Ajouter ma routine au panier</button>
      <button type="button" class="nat-finder__ghost" data-action="restart">Refaire le test</button>
    </div>
  </div>

</section>

<!-- Composer une cure qui vous ressemble -->
<div class="nat-wrap" style="padding-top:64px;padding-bottom:20px;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-radius:10px;overflow:hidden;box-shadow:0 1px 16px rgba(12,17,14,.07);">
    {%- if section.settings.routine_image != blank -%}{%- assign rimg = section.settings.routine_image | image_url: width: 1000 -%}{%- else -%}{%- assign rimg = 'prov-lavande.jpg' | asset_url -%}{%- endif -%}
    <div style="background-image:url('{{ rimg }}');background-size:cover;background-position:center;min-height:420px;"></div>
    <div style="background:#fff;padding:52px 48px;display:flex;flex-direction:column;justify-content:center;">
      <div class="nat-eyebrow" style="letter-spacing:.22em;">{{ section.settings.routine_eyebrow | default: 'La routine idéale' }}</div>
      <h2 class="nat-serif" style="font-size:36px;line-height:1.08;margin:12px 0 22px;">{{ section.settings.routine_title | default: 'Composer une cure qui vous ressemble' }}</h2>
      <div style="display:flex;flex-direction:column;gap:14px;">
        {%- assign checks = "Une cure ciblée sur 1 à 3 mois, plutôt qu'une prise ponctuelle|Le matin pour l'énergie, le soir pour la détente et le sommeil|Trois à quatre compléments complémentaires au maximum|Une pause d'une à deux semaines entre deux cures intensives" | split: '|' -%}
        {%- for c in checks -%}
          <div style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--olive);font-size:15px;">✦</span><span style="font-size:14.5px;color:var(--green-text);line-height:1.5;">{{ c }}</span></div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('NatDiag-{{ section.id }}');
  if(!root) return;

  var PRODUCTS = [
    {%- for product in col.products -%}
      {%- assign vid = product.selected_or_first_available_variant.id | default: product.variants.first.id -%}
      {%- if vid != blank -%}
      { vid: {{ vid }}, title: {{ product.title | json }}, url: {{ product.url | json }}, price: {{ product.price | money | json }}, img: {{ product.featured_image | image_url: width: 500 | json }}, sub: {{ product.metafields.custom.subtitle.value | default: '' | json }}, dosage: {{ product.metafields.custom.dosage_text.value | default: '' | json }}, objs: {{ product.tags | json }} },
      {%- endif -%}
    {%- endfor -%}
  ];

  var QUESTIONS = [
    { key:'q1', name:'Objectif', q:'Quel est votre objectif principal ?', w:2, options:[
      {label:'Renforcer mon immunité', icon:'🛡️', objs:['Immunité']},
      {label:'Mieux dormir', icon:'🌙', objs:['Sommeil']},
      {label:'Réduire mon stress', icon:'🧘', objs:['Stress']},
      {label:'Retrouver de l’énergie', icon:'⚡', objs:['Énergie']},
      {label:'Beauté peau & cheveux', icon:'✨', objs:['Beauté']},
      {label:'Confort articulaire', icon:'🦴', objs:['Articulations']}
    ]},
    { key:'q2', name:'Ressenti', q:'Comment vous sentez-vous en ce moment ?', w:1, options:[
      {label:'Fatigué·e', icon:'🥱', objs:['Énergie','Immunité']},
      {label:'Stressé·e / anxieux·se', icon:'😰', objs:['Stress']},
      {label:'Sommeil agité', icon:'🌙', objs:['Sommeil']},
      {label:'Peau terne', icon:'🌫️', objs:['Beauté']},
      {label:'Inconfort digestif', icon:'🌿', objs:['Digestion']},
      {label:'Tensions articulaires', icon:'🦵', objs:['Articulations']}
    ]},
    { key:'q3', name:'Mode de vie', q:'Votre rythme de vie ?', w:1, options:[
      {label:'Sportif·ve', icon:'🏃', objs:['Articulations','Énergie']},
      {label:'Vie pro intense', icon:'💼', objs:['Stress','Énergie']},
      {label:'Beaucoup d’écrans', icon:'💻', objs:['Sommeil']},
      {label:'Plutôt sédentaire', icon:'🛋️', objs:['Énergie']}
    ]}
  ];

  var step = 0, answers = {}, recVids = [];
  function $(s){ return root.querySelector(s); }
  function panel(name){ return root.querySelector('[data-step="'+name+'"]'); }
  function show(name){
    ['intro','question','result'].forEach(function(p){ panel(p).style.display = (p===name)?'':'none'; });
    try{ root.scrollIntoView({behavior:'smooth', block:'start'}); }catch(e){ window.scrollTo(0,0); }
  }

  function renderQuestion(){
    var q = QUESTIONS[step-1];
    $('[data-el="stepname"]').textContent = q.name;
    $('[data-el="bar"]').style.width = Math.round(step/QUESTIONS.length*100)+'%';
    $('[data-el="question"]').textContent = q.q;

    var box = $('[data-el="options"]'); box.innerHTML='';
    box.setAttribute('data-count', q.options.length);
    q.options.forEach(function(o,i){
      var b = document.createElement('button');
      b.type='button'; b.className='nat-finder__opt';
      if(answers[q.key]===i) b.className += ' is-selected';
      b.innerHTML = '<span class="nat-finder__opt-icon">'+(o.icon||'')+'</span><span class="nat-finder__opt-label">'+o.label+'</span><span class="nat-finder__opt-check">✓</span>';
      b.addEventListener('click', function(){
        answers[q.key]=i;
        Array.prototype.forEach.call(box.children, function(c){ c.classList.remove('is-selected'); });
        b.classList.add('is-selected');
        updateNav();
      });
      box.appendChild(b);
    });

    updateNav();
    show('question');
  }

  function updateNav(){
    var q = QUESTIONS[step-1];
    var nextBtn = root.querySelector('[data-action="next"]');
    var hasAnswer = answers[q.key] != null;
    nextBtn.disabled = !hasAnswer;
    var nextName = (step < QUESTIONS.length) ? QUESTIONS[step].name : 'Résultat';
    $('[data-el="nextname"]').textContent = nextName;
    root.querySelector('[data-action="back"]').style.visibility = (step>1) ? 'visible' : 'hidden';
  }

  function goNext(){
    var q = QUESTIONS[step-1];
    if(answers[q.key] == null) return;
    step++;
    if(step > QUESTIONS.length){ finish(); } else { renderQuestion(); }
  }

  function finish(){
    var score = {};
    QUESTIONS.forEach(function(q){ var ai=answers[q.key]; if(ai!=null && q.options[ai]){ q.options[ai].objs.forEach(function(o){ score[o]=(score[o]||0)+q.w; }); } });
    var ranked = Object.keys(score).sort(function(a,b){ return score[b]-score[a]; });
    var top = ranked.slice(0,2);

    var scored = PRODUCTS.map(function(p){
      var s = 0, why = '';
      p.objs.forEach(function(o){ if(score[o]){ s += score[o]; if(!why) why = o; } });
      return { p:p, s:s, why:why };
    }).filter(function(x){ return x.s > 0; })
      .sort(function(a,b){ return b.s - a.s; });

    var chosen = scored.slice(0,4);
    if(chosen.length < 3){
      PRODUCTS.forEach(function(p){
        if(chosen.length < 3 && !chosen.some(function(x){ return x.p.vid===p.vid; })){ chosen.push({ p:p, s:0, why:'' }); }
      });
    }
    recVids = chosen.map(function(x){ return x.p.vid; });
    $('[data-el="recTitle"]').textContent = top.length ? top.join(' & ') : 'Vitalité';

    var grid = $('[data-el="recProducts"]'); grid.innerHTML='';
    if(chosen.length===0){
      grid.style.display='none';
      $('[data-el="recEmpty"]').style.display='block';
    } else {
      grid.style.display=''; $('[data-el="recEmpty"]').style.display='none';
      chosen.forEach(function(x){
        var p = x.p;
        var card = document.createElement('div'); card.className='nat-card nat-card--reco';
        var media = p.img
          ? '<img class="nat-card__img nat-card__img--1" src="'+p.img+'" alt="">'
          : '<span class="nat-card__ph">'+p.title+'</span>';
        card.innerHTML =
          '<a href="'+p.url+'" class="nat-card__media">'+(x.why ? '<span class="nat-card__reco">✓ '+x.why+'</span>' : '')+media+'</a>'+
          '<a href="'+p.url+'" class="nat-card__name">'+p.title+'</a>'+
          (p.dosage ? '<div class="nat-card__sub">'+p.dosage+'</div>' : (p.sub ? '<div class="nat-card__sub">'+p.sub+'</div>' : ''))+
          '<div class="nat-card__row"><span class="nat-card__price">'+p.price+'</span>'+
          '<button type="button" class="nat-card__add" data-action="addOne" data-vid="'+p.vid+'">Ajouter</button></div>';
        grid.appendChild(card);
      });
    }
    show('result');
  }

  function addToCart(items, go, btn){
    if(!items.length) return;
    fetch('/cart/add.js', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({items:items})})
      .then(function(r){ return r.json(); })
      .then(function(){ if(go){ window.location.href='/cart'; } else if(btn){ btn.textContent='Ajouté ✓'; setTimeout(function(){ btn.textContent='Ajouter'; },1600); } })
      .catch(function(){ if(btn){ btn.textContent='Réessayer'; } });
  }

  root.addEventListener('click', function(e){
    var a = e.target.closest('[data-action]'); if(!a) return;
    var act = a.getAttribute('data-action');
    if(act==='start'){ step=1; answers={}; renderQuestion(); }
    else if(act==='restart'){ step=0; answers={}; show('intro'); }
    else if(act==='back'){ if(step>1){ step--; renderQuestion(); } }
    else if(act==='next'){ goNext(); }
    else if(act==='addOne'){ addToCart([{id:parseInt(a.getAttribute('data-vid'),10), quantity:1}], false, a); }
    else if(act==='addRoutine'){ addToCart(recVids.map(function(v){ return {id:v, quantity:1}; }), true); }
  });
})();
</script>

{% schema %}
{
  "name": "Page Diagnostic",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "header", "content": "Introduction" },
    { "type": "text", "id": "intro_eyebrow", "label": "Sur-titre", "default": "Diagnostic personnalisé" },
    { "type": "text", "id": "intro_title", "label": "Titre", "default": "Trouvez votre cure idéale" },
    { "type": "textarea", "id": "intro_text", "label": "Texte d'intro", "default": "Répondez à 3 questions sur vos besoins et votre mode de vie. Nous composons une routine de compléments alimentaires sur-mesure, en quelques secondes." },
    { "type": "text", "id": "start_label", "label": "Bouton de démarrage", "default": "Commencer le diagnostic" },
    { "type": "header", "content": "Bloc « Composer une cure »" },
    { "type": "text", "id": "routine_eyebrow", "label": "Sur-titre", "default": "La routine idéale" },
    { "type": "text", "id": "routine_title", "label": "Titre", "default": "Composer une cure qui vous ressemble" },
    { "type": "image_picker", "id": "routine_image", "label": "Image" },
    { "type": "header", "content": "Réglages" },
    { "type": "collection", "id": "collection", "label": "Collection source (produits recommandés)", "info": "Par défaut « Tous nos compléments ». Les tags des produits servent d'objectifs." }
  ],
  "presets": [ { "name": "Page Diagnostic" } ]
}
{% endschema %}
