{%- assign col = section.settings.collection -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['tous-nos-complements'] -%}{%- endif -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections.all -%}{%- endif -%}

<div class="nat-diag">
  <div class="nat-diag__inner" id="NatDiag-{{ section.id }}">

    <!-- intro -->
    <div data-step="intro" style="text-align:center;">
      <div class="nat-eyebrow" style="letter-spacing:.26em;">Diagnostic personnalisé</div>
      <h1 class="nat-serif" style="font-size:54px;line-height:1.05;margin:16px 0 0;">Trouvez votre cure idéale</h1>
      <p style="font-size:16px;line-height:1.65;color:var(--green-text);margin:18px auto 0;max-width:480px;">Répondez à 3 questions sur vos besoins et votre mode de vie. Nous composons une routine de compléments sur-mesure, en quelques secondes.</p>
      <div style="display:flex;justify-content:center;gap:32px;margin:34px 0 38px;">
        {%- assign labels = 'Objectif,Ressenti,Mode de vie' | split: ',' -%}
        {%- for l in labels -%}
          <div style="display:flex;flex-direction:column;align-items:center;gap:8px;">
            <div style="width:42px;height:42px;border-radius:999px;border:1.5px solid var(--sage);color:var(--olive);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:20px;">{{ forloop.index }}</div>
            <div style="font-size:12px;color:var(--brown-dark);">{{ l }}</div>
          </div>
        {%- endfor -%}
      </div>
      <button type="button" class="nat-btn" data-action="start">Commencer le diagnostic</button>
    </div>

    <!-- question -->
    <div data-step="question" style="display:none;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <span class="nat-eyebrow" data-el="progress"></span>
        <span data-action="restart" style="font-size:12px;color:#9a8b6c;cursor:pointer;">Recommencer</span>
      </div>
      <div class="nat-diag__bar"><span data-el="bar" style="width:0;"></span></div>
      <div data-el="dots" style="display:flex;gap:6px;margin-top:14px;"></div>
      <h2 class="nat-serif" data-el="question" style="font-size:38px;line-height:1.1;margin:26px 0 24px;"></h2>
      <div data-el="options" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;"></div>
      <div style="margin-top:22px;">
        <button type="button" class="nat-diag__back" data-action="back" style="display:none;background:none;border:none;color:var(--brown);font-size:13.5px;cursor:pointer;font-family:var(--sans);">← Précédent</button>
      </div>
    </div>

    <!-- résultat -->
    <div data-step="result" style="display:none;">
      <div style="text-align:center;">
        <div class="nat-eyebrow" style="letter-spacing:.26em;">Votre routine sur-mesure</div>
        <h1 class="nat-serif" style="font-size:46px;line-height:1.05;margin:14px 0 0;">Recommandé pour&nbsp;: <span data-el="recTitle"></span></h1>
        <p style="font-size:15px;color:var(--green-text);margin:14px auto 0;max-width:520px;">Voici les compléments les plus adaptés à vos réponses. Ajoutez-les à l'unité ou composez toute la routine en un clic.</p>
      </div>
      <div class="nat-grid-4" data-el="recProducts" style="gap:22px;margin:38px 0 0;"></div>
      <div data-el="recEmpty" style="display:none;text-align:center;margin-top:30px;">
        <a class="nat-btn" href="{{ routes.all_products_collection_url }}">Voir tous nos compléments</a>
      </div>
      <div style="display:flex;justify-content:center;gap:16px;margin-top:40px;flex-wrap:wrap;">
        <button type="button" class="nat-btn" data-action="addRoutine">Ajouter ma routine au panier</button>
        <button type="button" class="nat-btn nat-btn--outline" data-action="restart">Refaire le test</button>
      </div>
    </div>

  </div>
</div>

<!-- Composer une cure qui vous ressemble -->
<div class="nat-wrap" style="padding-top:64px;padding-bottom:20px;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;border-radius:10px;overflow:hidden;box-shadow:0 1px 16px rgba(12,17,14,.07);">
    {%- if section.settings.routine_image != blank -%}{%- assign rimg = section.settings.routine_image | image_url: width: 1000 -%}{%- else -%}{%- assign rimg = 'prov-lavande.jpg' | asset_url -%}{%- endif -%}
    <div style="background-image:url('{{ rimg }}');background-size:cover;background-position:center;min-height:420px;"></div>
    <div style="background:#fff;padding:52px 48px;display:flex;flex-direction:column;justify-content:center;">
      <div class="nat-eyebrow" style="letter-spacing:.22em;">La routine idéale</div>
      <h2 class="nat-serif" style="font-size:36px;line-height:1.08;margin:12px 0 22px;">Composer une cure qui vous ressemble</h2>
      <div style="display:flex;flex-direction:column;gap:14px;">
        {%- assign checks = "Une cure ciblée sur 1 à 3 mois, plutôt qu'une prise ponctuelle|Le matin pour l'énergie, le soir pour la détente et le sommeil|Trois à quatre compléments complémentaires au maximum|Une pause d'une à deux semaines entre deux cures intensives" | split: '|' -%}
        {%- for c in checks -%}
          <div style="display:flex;gap:12px;align-items:flex-start;"><span style="color:var(--olive);font-size:15px;">✦</span><span style="font-size:14.5px;color:var(--green-text);line-height:1.5;">{{ c }}</span></div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('NatDiag-{{ section.id }}');
  if(!root) return;

  // Catalogue produit (depuis la collection choisie). Virgule finale tolérée par JS.
  var PRODUCTS = [
    {%- for product in col.products -%}
      {%- assign vid = product.selected_or_first_available_variant.id | default: product.variants.first.id -%}
      {%- if vid != blank -%}
      { vid: {{ vid }}, title: {{ product.title | json }}, url: {{ product.url | json }}, price: {{ product.price | money | json }}, img: {{ product.featured_image | image_url: width: 500 | json }}, sub: {{ product.metafields.custom.subtitle.value | default: '' | json }}, dosage: {{ product.metafields.custom.dosage_text.value | default: '' | json }}, objs: {{ product.tags | json }} },
      {%- endif -%}
    {%- endfor -%}
  ];

  var QUESTIONS = [
    { key:'q1', q:'Quel est votre objectif principal ?', w:2, options:[
      {label:'Renforcer mon immunité', objs:['Immunité']},
      {label:'Mieux dormir', objs:['Sommeil']},
      {label:'Réduire mon stress', objs:['Stress']},
      {label:'Retrouver de l’énergie', objs:['Énergie']},
      {label:'Beauté peau & cheveux', objs:['Beauté']},
      {label:'Confort articulaire', objs:['Articulations']}
    ]},
    { key:'q2', q:'Comment vous sentez-vous en ce moment ?', w:1, options:[
      {label:'Fatigué·e', objs:['Énergie','Immunité']},
      {label:'Stressé·e / anxieux·se', objs:['Stress']},
      {label:'Sommeil agité', objs:['Sommeil']},
      {label:'Peau terne', objs:['Beauté']},
      {label:'Inconfort digestif', objs:['Digestion']},
      {label:'Tensions articulaires', objs:['Articulations']}
    ]},
    { key:'q3', q:'Votre rythme de vie ?', w:1, options:[
      {label:'Sportif·ve', objs:['Articulations','Énergie']},
      {label:'Vie pro intense', objs:['Stress','Énergie']},
      {label:'Beaucoup d’écrans', objs:['Sommeil']},
      {label:'Plutôt sédentaire', objs:['Énergie']}
    ]}
  ];

  var step = 0, answers = {}, recVids = [];
  function $(s){ return root.querySelector(s); }
  function panel(name){ return root.querySelector('[data-step="'+name+'"]'); }
  function show(name){ ['intro','question','result'].forEach(function(p){ panel(p).style.display = (p===name)?'':'none'; });
    try{ root.scrollIntoView({behavior:'smooth', block:'start'}); }catch(e){ window.scrollTo(0,0); } }

  function renderDots(){
    var d = $('[data-el="dots"]'); d.innerHTML='';
    for(var i=0;i<QUESTIONS.length;i++){
      var s = document.createElement('span');
      s.style.cssText = 'height:6px;flex:1;border-radius:999px;background:'+((i<step)?'var(--olive)':'#E1E6D7')+';';
      d.appendChild(s);
    }
  }

  function renderQuestion(){
    var q = QUESTIONS[step-1];
    $('[data-el="progress"]').textContent = 'Question '+step+' / '+QUESTIONS.length;
    $('[data-el="bar"]').style.width = Math.round((step-1)/QUESTIONS.length*100)+'%';
    $('[data-el="question"]').textContent = q.q;
    renderDots();
    var box = $('[data-el="options"]'); box.innerHTML='';
    q.options.forEach(function(o,i){
      var b = document.createElement('button');
      b.type='button'; b.className='nat-diag__opt';
      if(answers[q.key]===i) b.className += ' is-selected';
      b.innerHTML = '<span class="bullet"></span>'+o.label;
      b.addEventListener('click', function(){
        answers[q.key]=i;
        Array.prototype.forEach.call(box.children, function(c){ c.classList.remove('is-selected'); });
        b.classList.add('is-selected');
        setTimeout(function(){ step++; (step>QUESTIONS.length) ? finish() : renderQuestion(); }, 240);
      });
      box.appendChild(b);
    });
    $('[data-el="bar"]').style.width = Math.round(step/QUESTIONS.length*100)+'%';
    root.querySelector('[data-action="back"]').style.display = (step>1) ? 'inline-block' : 'none';
    show('question');
  }

  function finish(){
    var score = {};
    QUESTIONS.forEach(function(q){ var ai=answers[q.key]; if(ai!=null && q.options[ai]){ q.options[ai].objs.forEach(function(o){ score[o]=(score[o]||0)+q.w; }); } });
    var ranked = Object.keys(score).sort(function(a,b){ return score[b]-score[a]; });
    var top = ranked.slice(0,2);
    var ids = [];
    top.forEach(function(o){ PRODUCTS.forEach(function(p){ if(p.objs.indexOf(o)>=0 && ids.indexOf(p.vid)<0) ids.push(p.vid); }); });
    PRODUCTS.forEach(function(p){ if(ids.indexOf(p.vid)<0) ids.push(p.vid); });
    recVids = ids.slice(0,4);
    $('[data-el="recTitle"]').textContent = top.length ? top.join(' & ') : 'Vitalité';

    var grid = $('[data-el="recProducts"]'); grid.innerHTML='';
    if(recVids.length===0){
      grid.style.display='none';
      $('[data-el="recEmpty"]').style.display='block';
    } else {
      grid.style.display=''; $('[data-el="recEmpty"]').style.display='none';
      recVids.forEach(function(vid){
        var p = PRODUCTS.filter(function(x){ return x.vid===vid; })[0]; if(!p) return;
        var card = document.createElement('div'); card.className='nat-card';
        card.innerHTML =
          '<a href="'+p.url+'" class="nat-card__media">'+(p.img ? '<img src="'+p.img+'" alt="">' : '<span class="nat-card__ph">'+p.title+'</span>')+'</a>'+
          (p.objs && p.objs.length ? '<div class="nat-card__obj">'+p.objs.join(' · ')+'</div>' : '')+
          '<a href="'+p.url+'" class="nat-card__name">'+p.title+'</a>'+
          (p.dosage ? '<div class="nat-card__sub">Posologie : '+p.dosage+'</div>' : (p.sub ? '<div class="nat-card__sub">'+p.sub+'</div>' : ''))+
          '<div class="nat-card__row"><span class="nat-card__price">'+p.price+'</span>'+
          '<button type="button" class="nat-card__add" data-action="addOne" data-vid="'+p.vid+'">Ajouter</button></div>';
        grid.appendChild(card);
      });
    }
    show('result');
  }

  function addToCart(items, go, btn){
    if(!items.length) return;
    fetch('/cart/add.js', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({items:items})})
      .then(function(r){ return r.json(); })
      .then(function(){ if(go){ window.location.href='/cart'; } else if(btn){ btn.textContent='Ajouté ✓'; setTimeout(function(){ btn.textContent='Ajouter'; },1600); } })
      .catch(function(){ if(btn){ btn.textContent='Réessayer'; } });
  }

  root.addEventListener('click', function(e){
    var a = e.target.closest('[data-action]'); if(!a) return;
    var act = a.getAttribute('data-action');
    if(act==='start'){ step=1; answers={}; renderQuestion(); }
    else if(act==='restart'){ step=0; answers={}; show('intro'); }
    else if(act==='back'){ if(step>1){ step--; renderQuestion(); } }
    else if(act==='addOne'){ addToCart([{id:parseInt(a.getAttribute('data-vid'),10), quantity:1}], false, a); }
    else if(act==='addRoutine'){ addToCart(recVids.map(function(v){ return {id:v, quantity:1}; }), true); }
  });
})();
</script>

{% schema %}
{
  "name": "Page Diagnostic",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection source (produits recommandés)", "info": "Par défaut « Tous nos compléments ». Les tags des produits servent d'objectifs." },
    { "type": "image_picker", "id": "routine_image", "label": "Image « Composer une cure »" }
  ],
  "presets": [ { "name": "Page Diagnostic" } ]
}
{% endschema %}
