{% render 'section-fonts', section: section %}
<div style="background:var(--pale);padding:56px 48px;">
  <div class="nat-wrap" style="padding:0;">
    <div class="nat-eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 class="nat-serif" style="font-size:52px;margin:10px 0 0;">{{ blog.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <p style="font-size:15px;color:var(--green-text);margin:10px 0 0;max-width:560px;">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>
</div>

<div class="nat-wrap" style="padding-top:40px;padding-bottom:72px;">
  <!-- tags -->
  <div style="display:flex;gap:10px;margin-bottom:30px;flex-wrap:wrap;">
    <a href="{{ blog.url }}" style="font-size:12.5px;font-weight:600;padding:8px 18px;border-radius:999px;{% unless current_tags %}background:var(--green-deep);color:var(--cream);{% else %}border:1.5px solid #DCE2D0;{% endunless %}">Tous</a>
    {%- for tag in blog.all_tags -%}
      <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" style="font-size:12.5px;font-weight:600;padding:8px 18px;border-radius:999px;{% if current_tags contains tag %}background:var(--green-deep);color:var(--cream);{% else %}border:1.5px solid #DCE2D0;{% endif %}">{{ tag }}</a>
    {%- endfor -%}
  </div>

  {%- paginate blog.articles by 9 -%}
    <div class="nat-grid-3" style="gap:34px 28px;">
      {%- for article in blog.articles -%}
        <a class="nat-post" href="{{ article.url }}">
          <div class="nat-post__media" style="background-image:url('{{ article.image | image_url: width: 800 }}');{% if article.image == blank %}background:var(--beige-gold);{% endif %}"></div>
          <div class="nat-post__meta">{{ article.tags.first | default: 'Journal' }}</div>
          <div class="nat-post__title">{{ article.title }}</div>
          <div class="nat-post__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</div>
          <div class="nat-post__more">Lire l'article →</div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div style="margin-top:40px;text-align:center;">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Le journal Natélis" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Science de la plante, rituels de bien-être et inspiration de Provence." }
  ]
}
{% endschema %}
