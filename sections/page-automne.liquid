{% render 'section-fonts', section: section %}
{%- assign col = section.settings.collection -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['selection-dautomne'] -%}{%- endif -%}
{%- if col == blank or col.products.size == 0 -%}{%- assign col = collections['tous-nos-complements'] -%}{%- endif -%}
{%- comment -%} bandeau promo (masqué si le champ est vide) {%- endcomment -%}
{%- if section.settings.banner != blank -%}
  <div class="nat-automne-banner">{{ section.settings.banner }}</div>
{%- endif -%}

{%- comment -%} bannière de saison : large, courte, titre + sous-titre centrés {%- endcomment -%}
{%- if section.settings.image != blank -%}{%- assign aut_img = section.settings.image | image_url: width: 2400 -%}{%- else -%}{%- assign aut_img = 'automne.webp' | asset_url -%}{%- endif -%}
<div class="nat-wrap" style="padding-top:20px;">
  <div class="nat-season-banner">
    <img class="nat-season-banner__img" src="{{ aut_img }}" alt="Village de Provence dans les vignes d'automne">
    <div class="nat-season-banner__veil"></div>
    <div class="nat-season-banner__body">
      <h1 class="nat-season-banner__title">{{ section.settings.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="nat-season-banner__sub">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Sélection de saison : deux produits par ligne, chacun avec son explication -->
<div class="nat-wrap" style="padding-top:58px;padding-bottom:16px;">
  <div class="nat-section-head">
    <h2 class="nat-h2">{{ section.settings.why_title | default: 'Notre sélection de saison' }}</h2>
    <a class="nat-link" href="{{ col.url | default: routes.all_products_collection_url }}">Tout voir →</a>
  </div>
  <p style="font-size:14.5px;color:var(--brown);margin:10px 0 0;max-width:600px;">{{ section.settings.why_intro | default: 'Le bon actif, au bon moment de la saison — découvrez pourquoi chaque cure compte cet automne.' }}</p>
</div>

{%- comment -%}
  Chaque produit de la sélection est présenté avec un espace texte à côté, deux par ligne.
  Les textes « pourquoi ce produit » se règlent en no-code via les blocs (produit + texte),
  appariés par produit. À défaut de bloc, on déroule simplement la collection.
{%- endcomment -%}
<div class="nat-wrap" style="padding-top:34px;padding-bottom:80px;">
  {%- comment -%} deux mises en avant par ligne : orientation identique pour toutes {%- endcomment -%}
  <div class="nat-season-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign bp = block.settings.product -%}
        {%- if bp == blank -%}{%- assign bp = col.products[forloop.index0] -%}{%- endif -%}
        {%- render 'automne-row', bp: bp, heading: block.settings.title, text: block.settings.text, points: block.settings.points, rev: 1, attrs: block.shopify_attributes -%}
      {%- endfor -%}
    {%- else -%}
      {%- for product in col.products limit: 12 -%}
        {%- render 'automne-row', bp: product, rev: 1 -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page Sélection d'automne",
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "text", "id": "banner", "label": "Bannière", "default": "L'automne en Provence · Renforcez vos défenses naturellement" },
    { "type": "image_picker", "id": "image", "label": "Visuel" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Les cures essentielles de la saison" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Quand les jours raccourcissent, le corps a besoin de soutien. Immunité, énergie, sérénité — notre sélection pour traverser l'automne en pleine forme." },
    { "type": "collection", "id": "collection", "label": "Collection « Sélection d'automne »", "info": "Sert de repli si un bloc n'a pas de produit défini." },
    { "type": "header", "content": "Titre de la sélection" },
    { "type": "text", "id": "why_title", "label": "Titre", "default": "Notre sélection de saison" },
    { "type": "textarea", "id": "why_intro", "label": "Sous-titre", "default": "Le bon actif, au bon moment de la saison — découvrez pourquoi chaque cure compte cet automne." }
  ],
  "blocks": [
    {
      "type": "why", "name": "Produit + texte",
      "settings": [
        { "type": "header", "content": "Produit" },
        { "type": "product", "id": "product", "label": "Produit à mettre en avant" },
        { "type": "header", "content": "Texte (indépendant du produit)" },
        { "type": "text", "id": "title", "label": "Titre du panneau", "info": "Par défaut : le nom du produit." },
        { "type": "textarea", "id": "text", "label": "Paragraphe", "info": "Pourquoi ce produit pour cette saison." },
        { "type": "textarea", "id": "points", "label": "Points clés", "info": "Un point par ligne, affiché avec une puce ✦." }
      ]
    }
  ],
  "presets": [
    { "name": "Page Sélection d'automne", "blocks": [
      { "type": "why", "settings": { "text": "À l'arrivée du froid, la Vitamine C liposomale soutient vos défenses et combat la fatigue : le réflexe immunité de la saison." } },
      { "type": "why", "settings": { "text": "Avec moins de soleil, la Vitamine D3 devient essentielle pour l'immunité et la solidité osseuse de l'automne à l'hiver." } },
      { "type": "why", "settings": { "text": "Le Zinc complète le duo immunité : un coup de pouce naturel pour traverser la saison des refroidissements." } },
      { "type": "why", "settings": { "text": "Les Probiotiques renforcent la flore intestinale, première ligne de défense quand les microbes circulent." } }
    ] }
  ]
}
{% endschema %}
