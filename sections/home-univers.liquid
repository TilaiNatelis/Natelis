{% render 'section-fonts', section: section %}
<div class="nat-wrap" style="padding-top:52px;padding-bottom:64px;">
  <div class="nat-section-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="nat-section-head__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nat-h2">{{ section.settings.title }}</h2>
    </div>
    <a class="nat-link" href="{{ routes.all_products_collection_url }}">Tous les produits →</a>
  </div>
  {%- assign univers_defaults = 'prov-vignes.jpg,prov-lavande.jpg,prov-calanque.jpg,prov-calanque2.jpg' | split: ',' -%}
  {%- comment -%} même carte que « L'expérience Natélis », en grille de quatre {%- endcomment -%}
  <div class="nat-grid-4">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      {%- assign img = block.settings.image | default: col.featured_image -%}
      {%- if img != blank -%}
        {%- assign img_src = img | image_url: width: 700 -%}
      {%- else -%}
        {%- assign def = univers_defaults[forloop.index0] | default: univers_defaults.first -%}
        {%- assign img_src = def | asset_url -%}
      {%- endif -%}
      {%- comment -%} render n'accepte pas de filtres dans ses arguments : on précalcule {%- endcomment -%}
      {%- assign u_title = block.settings.title | default: col.title -%}
      {%- assign u_link = col.url | default: block.settings.link -%}
      {%- render 'card-rail',
            cr_image: img_src,
            cr_title: u_title,
            cr_text: block.settings.subtitle,
            cr_cta: 'Découvrir',
            cr_link: u_link,
            cr_attrs: block.shopify_attributes -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Univers",
  "max_blocks": 6,
  "settings": [
      { "type": "header", "content": "Polices (cette section)" },
      { "type": "select", "id": "heading_font_name", "label": "Police des titres", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Cormorant Garamond","label":"Cormorant Garamond"},{"value":"Playfair Display","label":"Playfair Display"},{"value":"EB Garamond","label":"EB Garamond"},{"value":"Lora","label":"Lora"},{"value":"Marcellus","label":"Marcellus"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Mulish","label":"Mulish"},{"value":"Raleway","label":"Raleway"}] },
      { "type": "select", "id": "body_font_name", "label": "Police du texte", "default": "", "options": [{"value":"","label":"Par défaut (global)"},{"value":"Mulish","label":"Mulish"},{"value":"Montserrat","label":"Montserrat"},{"value":"Poppins","label":"Poppins"},{"value":"Nunito Sans","label":"Nunito Sans"},{"value":"Work Sans","label":"Work Sans"},{"value":"Inter","label":"Inter"},{"value":"Raleway","label":"Raleway"},{"value":"Lora","label":"Lora"}] }
    ,
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Explorez par univers" }
  ],
  "blocks": [
    {
      "type": "univers", "name": "Carte univers",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optionnel)" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre" },
        { "type": "url", "id": "link", "label": "Lien (si pas de collection)" }
      ]
    }
  ],
  "presets": [
    { "name": "Univers", "blocks": [
      { "type": "univers", "settings": { "title": "Vitalité & immunité", "subtitle": "Énergie, défenses naturelles, anti-fatigue" } },
      { "type": "univers", "settings": { "title": "Beauté & sommeil", "subtitle": "Peau, cheveux et nuits sereines" } },
      { "type": "univers", "settings": { "title": "Sport & bien-être", "subtitle": "Articulations, récupération, équilibre" } },
      { "type": "univers", "settings": { "title": "Routines", "subtitle": "Des cures complètes, prêtes à suivre" } }
    ] }
  ]
}
{% endschema %}
