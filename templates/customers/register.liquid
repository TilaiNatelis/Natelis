<div class="nat-wrap" style="max-width:480px;padding:60px 32px;">
  <h1 class="nat-serif" style="font-size:42px;margin:0 0 24px;">Créer un compte</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="Prénom" style="width:100%;padding:13px 16px;margin-bottom:12px;border:1px solid var(--border);border-radius:6px;font-family:var(--sans);">
    <input type="text" name="customer[last_name]" placeholder="Nom" style="width:100%;padding:13px 16px;margin-bottom:12px;border:1px solid var(--border);border-radius:6px;font-family:var(--sans);">
    <input type="email" name="customer[email]" placeholder="E-mail" required style="width:100%;padding:13px 16px;margin-bottom:12px;border:1px solid var(--border);border-radius:6px;font-family:var(--sans);">
    <input type="password" name="customer[password]" placeholder="Mot de passe" style="width:100%;padding:13px 16px;margin-bottom:16px;border:1px solid var(--border);border-radius:6px;font-family:var(--sans);">
    <button type="submit" class="nat-btn" style="width:100%;">Créer mon compte</button>
  {%- endform -%}
</div>
