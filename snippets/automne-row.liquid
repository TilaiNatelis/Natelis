{%- comment -%}
  Ligne « produit + panneau de texte » réutilisable (Sélection d'automne & Nouveautés).
  Le produit et le texte sont totalement indépendants : modifier le texte ne touche pas au produit.
  Paramètres :
    - bp      : produit (objet)
    - heading : titre du panneau (optionnel ; défaut = nom du produit)
    - text    : paragraphe d'explication (optionnel)
    - points  : points clés, un par ligne, rendus avec ✦ (optionnel)
    - rev     : 0 = produit à droite / texte à gauche ; sinon produit à gauche / texte à droite
    - attrs   : shopify_attributes du bloc (édition no-code)
{%- endcomment -%}
{%- assign feat_heading = heading | default: bp.title -%}
<div class="nat-feat{% if rev == 0 %} nat-feat--rev{% endif %}" {{ attrs }}>

  <div class="nat-feat__product">
    <a href="{{ bp.url | default: '#' }}" class="nat-feat__media">
      {%- if bp.featured_image -%}
        <img src="{{ bp.featured_image | image_url: width: 700 }}" alt="{{ bp.title | escape }}">
      {%- else -%}
        <span class="nat-feat__ph">{{ bp.title }}</span>
      {%- endif -%}
    </a>
    <a href="{{ bp.url | default: '#' }}" class="nat-feat__name">{{ bp.title }}</a>
    <div class="nat-feat__buy">
      <span class="nat-feat__price">{{ bp.price | money }}</span>
      {%- if bp != blank -%}
        {%- form 'product', bp -%}
          <input type="hidden" name="id" value="{{ bp.selected_or_first_available_variant.id }}">
          <button type="submit" class="nat-btn nat-btn--outline nat-btn--sm"{% unless bp.available %} disabled{% endunless %}>{%- if bp.available -%}Ajouter{%- else -%}Épuisé{%- endif -%}</button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>

  <div class="nat-feat__panel">
    <div class="nat-feat__heading nat-serif">{{ feat_heading }}</div>
    {%- if text != blank -%}<p class="nat-feat__intro">{{ text }}</p>{%- endif -%}
    {%- if points != blank -%}
      {%- assign plist = points | newline_to_br | split: '<br />' -%}
      <ul class="nat-feat__points">
        {%- for pt in plist -%}
          {%- assign ptc = pt | strip -%}
          {%- if ptc != blank -%}<li><span>✦</span>{{ ptc }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

</div>
