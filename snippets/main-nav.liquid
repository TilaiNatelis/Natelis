{%- comment -%}
  Navigation principale + méga-menu avec vignettes.
  Chaque sous-catégorie affiche une photo :
    - liens collection -> image de la collection (modifiable dans Admin > Collections)
    - liens conseils    -> image de la collection d'univers associée
  Repli : 1re photo produit de la collection, sinon visuel par défaut.
{%- endcomment -%}
<nav class="nat-nav">
  <div class="nat-nav__list">
    {%- for link in linklists.main-menu.links -%}
      {%- assign t = link.title | downcase -%}
      {%- if t contains 'automne' -%}{%- assign cls = 'nat-nav__item nat-nav__item--automne' -%}
      {%- elsif t contains 'diagnostic' -%}{%- assign cls = 'nat-nav__item nat-nav__item--diag' -%}
      {%- else -%}{%- assign cls = 'nat-nav__item' -%}{%- endif -%}

      {%- if link.links.size > 0 -%}
        {%- if t contains 'conseil' -%}{%- assign all_label = 'Tous nos conseils' -%}{%- else -%}{%- assign all_label = 'Tous les produits' -%}{%- endif -%}
        <div class="nat-nav__parent">
          <a class="{{ cls }}{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }} ▾</a>
          <div class="nat-mega">
            <div class="nat-mega__cards">
              {%- for child in link.links -%}
                {%- assign seg = child.url | split: '/' | last -%}
                {%- assign cc = blank -%}
                {%- if child.url contains '/collections/' -%}{%- assign cc = collections[seg] -%}
                {%- elsif child.url contains 'vitalite' -%}{%- assign cc = collections['vitalite-immunite'] -%}
                {%- elsif child.url contains 'beaute' -%}{%- assign cc = collections['beaute-sommeil'] -%}
                {%- elsif child.url contains 'sport' -%}{%- assign cc = collections['sport-bien-etre'] -%}{%- endif -%}
                {%- assign thumb = cc.image | default: cc.products.first.featured_image -%}
                <a class="nat-mega__card" href="{{ child.url }}">
                  <span class="nat-mega__thumb" style="{% if thumb != blank %}background-image:url('{{ thumb | image_url: width: 240 }}');{% else %}background-image:url('{{ 'prov-lavande.jpg' | asset_url }}');{% endif %}"></span>
                  <span class="nat-mega__cardlabel">{{ child.title }}</span>
                </a>
              {%- endfor -%}
            </div>
            <a class="nat-mega__all" href="{{ link.url }}">{{ all_label }} →</a>
          </div>
        </div>
      {%- else -%}
        <a class="{{ cls }}{% if link.active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}

    {%- else -%}
      <a class="nat-nav__item nat-nav__item--automne" href="{{ routes.root_url }}pages/selection-automne">Sélection d'automne</a>
      <a class="nat-nav__item" href="{{ routes.all_products_collection_url }}">Nouveautés</a>
      <a class="nat-nav__item" href="{{ routes.all_products_collection_url }}">Produits</a>
      <a class="nat-nav__item" href="{{ routes.root_url }}pages/conseils">Conseils</a>
      <a class="nat-nav__item nat-nav__item--diag" href="{{ routes.root_url }}pages/diagnostic">Diagnostic</a>
    {%- endfor -%}
  </div>
</nav>
