{%- comment -%}
  Navigation principale + méga-menu avec vignettes.
  Chaque sous-catégorie affiche une photo :
    - liens collection -> image de la collection (modifiable dans Admin > Collections)
    - liens conseils    -> image de la collection d'univers associée
  Repli : 1re photo produit de la collection, sinon visuel par défaut.
{%- endcomment -%}
<nav class="nat-nav">
  <div class="nat-nav__list">
    {%- for link in linklists.main-menu.links -%}
      {%- assign t = link.title | downcase -%}
      {%- if t contains 'automne' -%}{%- assign cls = 'nat-nav__item nat-nav__item--automne' -%}
      {%- elsif t contains 'diagnostic' -%}{%- assign cls = 'nat-nav__item nat-nav__item--diag' -%}
      {%- else -%}{%- assign cls = 'nat-nav__item' -%}{%- endif -%}

      {%- if link.links.size > 0 -%}
        {%- if t contains 'conseil' -%}{%- assign all_label = 'Tous nos conseils' -%}{%- else -%}{%- assign all_label = 'Tous les produits' -%}{%- endif -%}
        <div class="nat-nav__parent">
          <a class="{{ cls }} nat-nav__item--has-mega{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
          <div class="nat-mega">
            <div class="nat-mega__cards">
              {%- for child in link.links -%}
                {%- comment -%}
                  On saute la vignette « Tous les produits / Tous nos conseils » :
                  le lien est déjà repris en pied de méga-menu.
                {%- endcomment -%}
                {%- assign child_t = child.title | downcase -%}
                {%- if child.url == link.url or child_t contains 'tous les produits' or child_t contains 'tous nos conseils' or child_t contains 'tout voir' -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign seg = child.url | split: '/' | last -%}
                {%- assign cc = blank -%}
                {%- assign blogthumb = blank -%}
                {%- if child.url contains '/blogs/' -%}
                  {%- assign bb = blogs[seg] -%}
                  {%- assign blogthumb = bb.articles.first.image -%}
                {%- elsif child.url contains '/collections/' -%}{%- assign cc = collections[seg] -%}
                {%- elsif child.url contains 'vitalite' -%}{%- assign cc = collections['vitalite-immunite'] -%}
                {%- elsif child.url contains 'beaute' -%}{%- assign cc = collections['beaute-sommeil'] -%}
                {%- elsif child.url contains 'sport' -%}{%- assign cc = collections['sport-bien-etre'] -%}
                {%- elsif child.url contains 'conseil' -%}{%- assign cc = collections['tous-nos-complements'] -%}{%- endif -%}
                {%- assign thumb = blogthumb | default: cc.image | default: cc.products.first.featured_image -%}
                <a class="nat-mega__card" href="{{ child.url }}">
                  <span class="nat-mega__thumb" style="{% if thumb != blank %}background-image:url('{{ thumb | image_url: width: 240 }}');{% else %}background-image:url('{{ 'prov-lavande.jpg' | asset_url }}');{% endif %}"></span>
                  <span class="nat-mega__cardlabel">{{ child.title }}</span>
                </a>
              {%- endfor -%}
            </div>
            <div class="nat-mega__foot">
              <a class="nat-mega__all" href="{{ link.url }}">{{ all_label }} <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      {%- else -%}
        <a class="{{ cls }}{% if link.active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}

    {%- else -%}
      <a class="nat-nav__item nat-nav__item--automne" href="{{ routes.root_url }}pages/selection-automne">Sélection d'automne</a>
      <a class="nat-nav__item" href="{{ routes.all_products_collection_url }}">Nouveautés</a>
      <a class="nat-nav__item" href="{{ routes.all_products_collection_url }}">Produits</a>
      <a class="nat-nav__item" href="{{ routes.root_url }}pages/conseils">Conseils</a>
      <a class="nat-nav__item nat-nav__item--diag" href="{{ routes.root_url }}pages/diagnostic">Diagnostic</a>
    {%- endfor -%}
  </div>
</nav>

{%- comment -%} ---------- Navigation mobile (tiroir) ---------- {%- endcomment -%}
<div class="nat-mnav-overlay" id="NatMnavOverlay"></div>
<aside class="nat-mnav" id="NatMnav" aria-hidden="true">
  <div class="nat-mnav__head">
    <span class="nat-logo-text" style="font-size:26px;">Natélis</span>
    <button type="button" class="nat-mnav__close" id="NatMnavClose" aria-label="Fermer">×</button>
  </div>
  <nav class="nat-mnav__list">
    {%- for link in linklists.main-menu.links -%}
      {%- if link.links.size > 0 -%}
        <details class="nat-mnav__group">
          <summary>{{ link.title }}</summary>
          <a class="nat-mnav__sub nat-mnav__sub--all" href="{{ link.url }}">Tout voir →</a>
          {%- for child in link.links -%}
            <a class="nat-mnav__sub" href="{{ child.url }}">{{ child.title }}</a>
          {%- endfor -%}
        </details>
      {%- else -%}
        <a class="nat-mnav__link" href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
    <a class="nat-mnav__link" href="{{ routes.search_url }}">Rechercher</a>
    <a class="nat-mnav__link" href="{{ routes.account_url | default: routes.account_login_url }}">Mon compte</a>
  </nav>
</aside>

<script>
  (function(){
    var b = document.getElementById('NatBurger');
    var m = document.getElementById('NatMnav');
    var o = document.getElementById('NatMnavOverlay');
    var c = document.getElementById('NatMnavClose');
    if(!b || !m) return;
    function open(){ m.classList.add('is-open'); o.classList.add('is-open'); b.setAttribute('aria-expanded','true'); m.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; }
    function close(){ m.classList.remove('is-open'); o.classList.remove('is-open'); b.setAttribute('aria-expanded','false'); m.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }
    b.addEventListener('click', open);
    c.addEventListener('click', close);
    o.addEventListener('click', close);
    document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });
  })();
</script>
