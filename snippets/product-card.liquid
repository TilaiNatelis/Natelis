{%- comment -%}
  Carte produit Natélis.
  Paramètre : product (objet produit Shopify).
  Métachamps optionnels :
    - custom.subtitle (single_line_text)  → sous-titre
    - custom.rating (number)              → note (ex. 4.8)
    - custom.rating_count (number)        → nb d'avis
  Pastille (en haut à gauche), par ordre de priorité :
    1. promotion  → prix barré présent
    2. nouveauté  → tag "Nouveau"
    3. best-seller → tag "Best-seller"
{%- endcomment -%}
{%- assign sub = product.metafields.custom.subtitle | default: product.type -%}
{%- assign rating = product.metafields.custom.rating -%}
{%- assign rating_count = product.metafields.custom.rating_count -%}
{%- assign badge = '' -%}
{%- assign badge_kind = '' -%}
{%- if product.compare_at_price_max > product.price_min -%}
  {%- assign badge = 'Offre spéciale' -%}{%- assign badge_kind = 'promo' -%}
{%- elsif product.tags contains 'Nouveau' or product.tags contains 'Nouveauté' -%}
  {%- assign badge = 'Nouveau' -%}{%- assign badge_kind = 'new' -%}
{%- elsif product.tags contains 'Best-seller' -%}
  {%- assign badge = 'Best-seller' -%}{%- assign badge_kind = 'best' -%}
{%- endif -%}
{%- comment -%} les tags déjà repris dans la pastille ne sont pas répétés sous le visuel {%- endcomment -%}
{%- assign objtags = '' -%}
{%- for t in product.tags -%}
  {%- unless t == 'Best-seller' or t == 'Nouveau' or t == 'Nouveauté' -%}
    {%- if objtags != '' -%}{%- assign objtags = objtags | append: ' · ' -%}{%- endif -%}
    {%- assign objtags = objtags | append: t -%}
  {%- endunless -%}
{%- endfor -%}

<div class="nat-card">
  <a href="{{ product.url }}" class="nat-card__media">
    {%- if badge != blank -%}<span class="nat-card__badge nat-card__badge--{{ badge_kind }}">{{ badge }}</span>{%- endif -%}
    {%- if product.featured_image -%}
      <img class="nat-card__img nat-card__img--1" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy">
      {%- if product.images[1] -%}
        <img class="nat-card__img nat-card__img--2" src="{{ product.images[1] | image_url: width: 600 }}" alt="" loading="lazy">
      {%- endif -%}
    {%- else -%}
      <span class="nat-card__ph">{{ product.title }}</span>
    {%- endif -%}
  </a>

  {%- if objtags != blank -%}
    <a href="{{ product.url }}" class="nat-card__obj">{{ objtags }}</a>
  {%- endif -%}
  <a href="{{ product.url }}" class="nat-card__name">{{ product.title }}</a>
  {%- if sub != blank -%}<div class="nat-card__sub">{{ sub }}</div>{%- endif -%}

  {%- if rating != blank -%}
    <div class="nat-card__rating">★★★★★ <span>{{ rating }}{% if rating_count != blank %} · {{ rating_count }} avis{% endif %}</span></div>
  {%- endif -%}

  <div class="nat-card__row">
    <span class="nat-card__price">{{ product.price | money }}{%- if product.compare_at_price > product.price -%}<s class="nat-card__compare">{{ product.compare_at_price | money }}</s>{%- endif -%}</span>
    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="nat-card__add"{% unless product.available %} disabled{% endunless %}>
        {%- if product.available -%}Ajouter{%- else -%}Épuisé{%- endif -%}
      </button>
    {%- endform -%}
  </div>
</div>
